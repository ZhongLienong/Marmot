module ArrayLiteralUnifiesElements

// The elements of an array literal share one type, which each may tell more
// of. `[[], [1]]` was rejected because Array<Undecided> is not Array<Int>.

import { "../../../MarmotPrelude/IO.mmt" }

def nested = [[], [1], [2, 3]];

IO::PrintLine((#nested) as Text);
IO::PrintLine((#nested[2]) as Text);
