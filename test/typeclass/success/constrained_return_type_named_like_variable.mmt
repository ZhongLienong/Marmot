module T0Results

// The module prefix must resemble an inference variable to expose the regression.
foreign "MARMOT_FFI_Print" Print: fn(Text) -> Unit from "marmotstdlib";

class Convertible<From, To>
{
    Convert: fn(value: From) -> To;
};

type Box =
{
    value: Int
};

instance Convertible<Int, Box>
{
    def Convert = fn(value: Int) -> Box => Box(value);
};

instance Convertible<Int, Text>
{
    def Convert = fn(value: Int) -> Text => "text";
};

def Make = fn<T, U>(value: T, _other: U) -> Box where Convertible<T, Box>, Convertible<U, Text> => Convertible::Convert(value);

def actual = Make(7, 8);
Print(if actual.value == 7
then "ok\n"
else "wrong\n");
