module TestConvertibleSimple
// Test Convertible class defined inline (same file)
import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }

class Convertible<From, To>
{
    Convert: fn(value: From) -> To;
};

// Bool -> Int conversion
instance Convertible<Bool, Int>
{
    def Convert = fn(value: Bool) -> Int =>
    {
        if value
        then 1
        else 0
    };
};

// Bool -> Text conversion
instance Convertible<Bool, Text>
{
    def Convert = fn(value: Bool) -> Text =>
    {
        if value
        then "true"
        else "false"
    };
};

// Test Bool -> Int
IO::PrintLine("true->Int: " ++ ((true as Int) as Text));
IO::PrintLine("false->Int: " ++ ((false as Int) as Text));

// Test Bool -> Text
IO::PrintLine("true->Text: " ++ (true as Text));
IO::PrintLine("false->Text: " ++ (false as Text));

IO::PrintLine("test_convertible_simple: PASS");
