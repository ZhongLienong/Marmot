module TestConvertibleMinimal
// Minimal test of Convertible class - just verify it compiles and runs
import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }

class Convertible<From, To>
{
    Convert: fn(value: From) -> To;
};

// Bool -> Int conversion
instance Convertible<Bool, Int>
{
    def Convert = fn(value: Bool) -> Int =>
    {
        if value
        then 1
        else 0
    };
};

def BoolToInt = fn<T>(value: T) -> Int where Convertible<T, Int> =>
{
    Convertible::Convert(value)
};

// Just test that it works
def result_true = BoolToInt(true);

def result_false = BoolToInt(false);

// Verify results (1 and 0)
if result_true == 1
then
{
    IO::PrintLine("Bool->Int conversion: WORKING");
}
else
{
    IO::PrintLine("Bool->Int conversion: FAILED");
};

IO::PrintLine("test_convertible_minimal: PASS");
