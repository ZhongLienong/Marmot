module OperatorLibrary
import { "../../../projects/marmotstdlib/MarmotPrelude/Numeric.mmt" }
public export { Box, Both }

type Box<T> =
{
    value: T
};

instance Add<Box<L>, Box<R>> where Add<L, R>
{
    type Output = Box<Add::Output<L, R>>;
    def Add = fn(a: Box<L>, b: Box<R>) -> Box<Add::Output<L, R>> => Box(a.value + b.value);
};

instance Add<Box<T>, Int> where Add<T, Int>
{
    type Output = Box<Add::Output<T, Int>>;
    def Add = fn(a: Box<T>, b: Int) -> Box<Add::Output<T, Int>> => Box(a.value + b);
};

def Both = fn<L, R>(a: L, b: R) -> (Add::Output<L, R>, Add::Output<L, Int>) where Add<L, R>, Add<L, Int> => (a + b, a + 10);
