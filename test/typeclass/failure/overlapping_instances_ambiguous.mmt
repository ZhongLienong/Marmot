module OverlappingInstancesAmbiguous

// Two instances that both match are ambiguous, not missing. The error said no
// instance was found.

import { "../../../MarmotPrelude/IO.mmt" }

class Show<T> { show: fn(value: T) -> Text; };

type Boxed<T> = { item: T };

instance Show<Boxed<T>> { def show = fn(value: Boxed<T>) -> Text => "generic"; };

instance Show<Boxed<Int>> { def show = fn(value: Boxed<Int>) -> Text => "int"; };

def Display = fn<T>(value: T) -> Text where Show<T> => Show::show(value);

IO::PrintLine(Display(Boxed(1)));
