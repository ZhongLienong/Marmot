module MissingConstraint
// Test: Generic function trying to use 'as' without constraint should fail
import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Convertible.mmt" }

// This should fail at type checking because there's no Convertible<T, Text> constraint
def ToTextMissingConstraint = fn<T>(value: T) -> Text =>
{
    value as Text  // ERROR: Should require Convertible<T, Text> constraint
};

def result = ToTextMissingConstraint(42);
IO::PrintLine(result);
