module ReadmeManOrBoy

def A = fn(k: Int, x1: fn() -> Int, x2: fn() -> Int, x3: fn() -> Int, x4: fn() -> Int, x5: fn() -> Int) -> Int =>
{
    def cell = ref k;
    def B = fn() -> Int => {
        cell := (*cell) - 1;
        A(*cell, B, x1, x2, x3, x4)
    };
    if k > 0 then B() else x4() + x5()
};

def answer = A(10, fn() -> Int => 1, fn() -> Int => -1, fn() -> Int => -1, fn() -> Int => 1, fn() -> Int => 0);  // -67
