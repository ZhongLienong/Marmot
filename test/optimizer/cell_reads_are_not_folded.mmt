module CellReadsAreNotFolded

import
{
	"../../MarmotPrelude/IO.mmt"
}

// Every optimizer pass runs over this. A pass that treated reference reads as pure
// could reuse the first read after a write, or drop the write because its value is
// discarded.

def Probe = fn(c: Ref<Int>) -> Int =>
{
	def before = *c;
	c := before * 2;
	def after = *c;
	before + after
};

def c = ref 7;
IO::PrintLine((Probe(c) as Text) ++ " " ++ (*c as Text));
