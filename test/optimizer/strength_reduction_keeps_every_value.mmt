module StrengthReductionKeepsEveryValue

// Test: an identity is applied only where it holds for every value. x * 0
// still computes x when that has an effect; x * 0.0 is NaN for an infinite x
// and -0.0 for a negative one; -0.0 + 0.0 is 0.0.

import { "../../MarmotPrelude/IO.mmt" }

def Noisy = fn(x: Int) -> Int =>
{
	IO::PrintLine("computed " ++ (x as Text));
	x
};

def Times = fn(x: Float, y: Float) -> Float => x * y;

def negative_zero = 0.0 * (0.0 - 1.0);
def infinity = 1.0 / 0.0;

IO::PrintLine((Noisy(3) * 0) as Text);
IO::PrintLine((0 * Noisy(4)) as Text);
IO::PrintLine((infinity * 0.0) as Text);
IO::PrintLine(((0.0 - 3.0) * 0.0) as Text);
IO::PrintLine((Times(0.0 - 3.0, 1.0) * 0.0) as Text);
IO::PrintLine(negative_zero as Text);
IO::PrintLine((negative_zero + 0.0) as Text);
IO::PrintLine((negative_zero - 0.0) as Text);
IO::PrintLine((Times(negative_zero, 1.0) + 0.0) as Text);
IO::PrintLine((Times(negative_zero, 1.0) + (0.0 - 0.0)) as Text);
IO::PrintLine((infinity * 1.0) as Text);
