module CapturedRef
import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }

// A closure that captures a Ref shares the cell with its enclosing scope.

def NotCaptured = fn() -> Int =>
{
    def c = ref 1;
    c := (*c) + 1;
    *c
};

def Captured = fn() -> Int =>
{
    def c = ref 1;
    def Bump = fn() -> Int =>
    {
        c := (*c) + 10;
        *c
    };
    def after_closure = Bump();
    (*c) + after_closure
};

IO::PrintLine((NotCaptured() as Text) ++ " " ++ (Captured() as Text));
