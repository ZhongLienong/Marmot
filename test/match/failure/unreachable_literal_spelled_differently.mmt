module UnreachableLiteralSpelledDifferently
import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }

// Both spellings describe the same Int, so the second case matches nothing
// the first does not.

def Describe = fn(n: Int) -> Text => match n with
    case 256 => "two hundred fifty-six"
    case 0x100 => "hex"
    case _ => "other";

IO::PrintLine(Describe(256));
