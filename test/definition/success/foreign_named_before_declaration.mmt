module ForeignNamedBeforeDeclaration

// Test: a function may call a foreign function declared below it, like any
// later definition. The call must still reach the builtin by its index: taken
// by name it would marshal an array for a native library, and the builtin
// would stop with "Built-in FFI expected Array".

import { "../../../MarmotPrelude/IO.mmt" }

def Middle = fn(values : Array<Int>) -> Array<Int> => Cut(values, 1, #values - 1);
def Shout = fn(text : Text) -> Text => Upper(text) ++ "!";

foreign "MIDORI_FFI_ArraySlice" Cut: fn(Array<Int>, Int, Int) -> Array<Int>;
foreign "MIDORI_FFI_TextReverse" Upper: fn(Text) -> Text;

IO::PrintLine(#Middle([1, 2, 3, 4, 5]) as Text);
IO::PrintLine(Shout("olleh"));
