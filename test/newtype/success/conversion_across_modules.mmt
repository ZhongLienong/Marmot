module ConversionAcrossModules

// Test: a newtype converts to and from its representation in a module that
// imports it. The declaring module derives those two conversions itself, and
// they were not among the instances an importer learns, so `as` found none.

import { "conversion_across_modules_lib.mmt", "../../../MarmotPrelude/IO.mmt" }

def distance = 21 as ConversionAcrossModulesLib::Meters;
IO::PrintLine((ConversionAcrossModulesLib::Double(distance) as Int) as Text);
