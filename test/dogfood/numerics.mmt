module Numerics

import
{
	"../../MarmotPrelude/IO.mmt",
	"../../MarmotPrelude/Math.mmt",
	"../../MarmotPrelude/TextUtil.mmt",
	"../../MarmotPrelude/Prelude/Option.mmt",
	"../../MarmotPrelude/Hashable.mmt"
}

use Option.{ Option }

def Line = fn(label: Text, value: Text) -> Unit => IO::PrintLine(label ++ ": " ++ value);

// Floats go through Id so they are computed at run time: folding is float_folding.mmt's subject.
def Id = fn(x: Float) -> Float => x;

def max_int = 9223372036854775807;
def min_int = -9223372036854775807 - 1;

Line("max+1", (max_int + 1) as Text);
Line("min-1", (min_int - 1) as Text);
Line("min/-1", (min_int / -1) as Text);
Line("min%-1", (min_int % -1) as Text);
Line("max*2", (max_int * 2) as Text);
Line("-7/2", (-7 / 2) as Text);
Line("-7%2", (-7 % 2) as Text);
Line("7%-2", (7 % -2) as Text);
Line("neg min", (-min_int) as Text);

Line("1<<63", (1 << 63) as Text);
Line("1<<64", (1 << 64) as Text);
Line("-1>>70", (-1 >> 70) as Text);
Line("-16>>2", (-16 >> 2) as Text);
Line("1<<-1", (1 << -1) as Text);
Line("~0", (~0) as Text);
Line("xor", (0x5A5A ^ 0x0FF0) as Text);

def b : Byte = 0xF0;
def b2 : Byte = 0x20;
Line("byte add", (b + b2) as Text);
Line("byte sub", (b2 - b) as Text);
Line("byte mul", (b * b2) as Text);
Line("byte not", (b ^ 0xFF) as Text);
Line("byte shl", (b << 1) as Text);
Line("byte to int", ((b as Int) + 1000) as Text);
Line("int to byte", ((300 as Byte) as Int) as Text);
Line("neg int to byte", ((-1 as Byte) as Int) as Text);

def w : Word = 0xFFFFFFFFFFFFFFFF;
Line("word max", w as Text);
Line("word+1", (w + (1 as Word)) as Text);
Line("word/3", (w / (3 as Word)) as Text);
Line("word>>60", (w >> 60) as Text);
Line("word as int", (w as Int) as Text);
Line("int -1 as word", (-1 as Word) as Text);
Line("word cmp", ((w > (1 as Word)) as Text));

Line("0.1+0.2", (Id(0.1) + 0.2) as Text);
Line("1/3", (Id(1.0) / 3.0) as Text);
Line("whole", 2.0 as Text);
Line("big", Math::Pow(10.0, 300.0) as Text);
Line("tiny", 0.000001 as Text);
Line("neg zero", (-0.0) as Text);
Line("sqrt2", Math::SquareRoot(2.0) as Text);
Line("pi", Math::Pi as Text);
Line("1/0", (Id(1.0) / 0.0) as Text);
Line("-1/0", (Id(-1.0) / 0.0) as Text);
def nan = Id(0.0) / 0.0;
Line("nan==nan", (nan == nan) as Text);
Line("nan!=nan", (nan != nan) as Text);
Line("nan<1", (nan < 1.0) as Text);
Line("isnan", Math::IsNaN(nan) as Text);
Line("float to int", (3.99 as Int) as Text);
Line("neg float to int", (-3.99 as Int) as Text);
Line("int to float", (9007199254740993 as Float) as Text);
Line("round", Math::Round(2.5) as Text);
Line("floor neg", Math::Floor(-2.5) as Text);
Line("pow", Math::Pow(2.0, 0.5) as Text);
Line("fmod", Math::Fmod(-7.5, 2.0) as Text);
Line("atan2", Math::Atan2(1.0, -1.0) as Text);
Line("hash float eq", (Hashable::Hash(0.0) == Hashable::Hash(-0.0)) as Text);

Line("text to int", ("  42" |> TextUtil::ParseInt |> fn(o: Option<Int>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("text to int neg", ("-17" as Int) as Text);
Line("text to int plus", (TextUtil::ParseInt("+17") |> fn(o: Option<Int>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("text to int overflow", (TextUtil::ParseInt("9223372036854775808") |> fn(o: Option<Int>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("text to float", ("2.5e-3" as Float) as Text);
Line("text to float bad", (TextUtil::ParseFloat("1.2.3") |> fn(o: Option<Float>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("text to float inf", (TextUtil::ParseFloat("inf") |> fn(o: Option<Float>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("text to float nan", (TextUtil::ParseFloat("nan") |> fn(o: Option<Float>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("hex text", (TextUtil::ParseInt("0x1F") |> fn(o: Option<Int>) -> Text => match o with case Option::Some(n) => n as Text case Option::None() => "none"));
Line("bool text", true as Text);
Line("float eq int", ((3 as Float) == 3.0) as Text);

def Collatz = fn(n: Int, steps: Int) -> Int => if n == 1 then steps else Collatz(if (n % 2) == 0 then n / 2 else (3 * n) + 1, steps + 1);
def LongestCollatz = fn(n: Int, limit: Int, best: Int, best_steps: Int) -> (Int, Int) =>
	if n >= limit
	then (best, best_steps)
	else
	{
		def steps = Collatz(n, 0);
		if steps > best_steps then LongestCollatz(n + 1, limit, n, steps) else LongestCollatz(n + 1, limit, best, best_steps)
	};
def (collatz_n, collatz_steps) = LongestCollatz(1, 100000, 1, 0);
Line("collatz", (collatz_n as Text) ++ " " ++ (collatz_steps as Text));

def Gcd = fn(m: Int, n: Int) -> Int => if n == 0 then m else Gcd(n, m % n);
def PowMod = fn(base: Int, exponent: Int, modulus: Int, acc: Int) -> Int =>
	if exponent == 0
	then acc
	else PowMod((base * base) % modulus, exponent >> 1, modulus, if (exponent & 1) == 1 then (acc * base) % modulus else acc);
Line("gcd", Gcd(1071, 462) as Text);
Line("powmod", PowMod(2, 1000000, 1000000007, 1) as Text);

def Sieve = fn(limit: Int) -> Int =>
{
	def marks = [true for _ in 0..1..limit];
	CountPrimes(MarkAll(marks, 2, limit), 2, 0)
};
def MarkAll = fn(marks: Array<Bool>, p: Int, limit: Int) -> Array<Bool> =>
	if (p * p) >= limit
	then marks
	else if marks[p]
	then MarkAll([if (i > p) && ((i % p) == 0) then false else marks[i] for i in 0..1..limit], p + 1, limit)
	else MarkAll(marks, p + 1, limit);
def CountPrimes = fn(marks: Array<Bool>, i: Int, count: Int) -> Int =>
	if i >= #marks then count else CountPrimes(marks, i + 1, if marks[i] then count + 1 else count);
Line("primes<10000", Sieve(10000) as Text);

def Mandel = fn(cx: Float, cy: Float, x: Float, y: Float, i: Int) -> Int =>
	if (i >= 50) || (((x * x) + (y * y)) > 4.0)
	then i
	else Mandel(cx, cy, ((x * x) - (y * y)) + cx, ((2.0 * x) * y) + cy, i + 1);
def Row = fn(y: Int) -> Text =>
	TextUtil::Replace(Join([if Mandel(((x as Float) / 20.0) - 2.0, ((y as Float) / 10.0) - 1.2, 0.0, 0.0, 0) >= 50 then "#" else "." for x in 0..1..60]), " ", "");
def Join = fn(parts: Array<Text>) -> Text => JoinFrom(parts, 0, "");
def JoinFrom = fn(parts: Array<Text>, index: Int, built: Text) -> Text => if index >= #parts then built else JoinFrom(parts, index + 1, built ++ parts[index]);
for y in 0..3..25 {
	IO::PrintLine(Row(y));
};

