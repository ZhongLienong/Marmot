module ManOrBoy

import
{
	"../../MarmotPrelude/IO.mmt"
}

// Knuth's Man or Boy test. B changes the k of the call to A that created it, and
// every B made by that call sees the change: the k lives in a cell they share.

def A = fn(k: Int, x1: fn() -> Int, x2: fn() -> Int, x3: fn() -> Int, x4: fn() -> Int, x5: fn() -> Int) -> Int =>
{
	def cell = ref k;
	def B = fn() -> Int => {
		cell := (*cell) - 1;
		A(*cell, B, x1, x2, x3, x4)
	};
	if k > 0 then B() else x4() + x5()
};

def results = [A(k, fn() -> Int => 1, fn() -> Int => -1, fn() -> Int => -1, fn() -> Int => 1, fn() -> Int => 0) for k in 0..1..11];
for r in results
{
	IO::Print((r as Text) ++ " ");
};
IO::PrintLine("");
