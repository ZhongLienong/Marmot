module PreludeArrayUtilWith
import { "../../../projects/marmotstdlib/MarmotPrelude/ArrayUtil.mmt", "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Panic.mmt" }

def Expect = fn(condition: Bool, message: Text) -> Unit => if condition
then ()
else Panic::Panic(message);

def Show = fn(array: Array<Int>) -> Text =>
{
    def parts: Array<Text> = [array[i] as Text for i in 0..1..ArrayUtil::Length(array)];
    if ArrayUtil::Length(parts) == 0
    then "-"
    else ArrayUtil::Length(parts) as Text ++ ":" ++ parts[0] ++ ":" ++ parts[ArrayUtil::Length(parts) - 1]
};

def base = [10, 20, 30];

def empty: Array<Int> = [];

// These bounds must be clamped before they are narrowed to storage indexes.
def whole = ArrayUtil::Slice(base, -4294967295, 2147483648);
Expect((#whole == 3) && (whole[0] == 10) && (whole[2] == 30), "Slice clamps full-width endpoints");
Expect
(
    #ArrayUtil::Slice(base, 4294967297, 9223372036854775807) == 0,
    "Slice clamps a large start to the end"
);

// The original must survive every operation.
def appended = ArrayUtil::WithAppended(base, 40);
Expect(ArrayUtil::Length(base) == 3, "WithAppended must not modify the original");
Expect((ArrayUtil::Length(appended) == 4) && (appended[3] == 40), "WithAppended appends");
Expect(ArrayUtil::Length(ArrayUtil::WithAppended(empty, 1)) == 1, "WithAppended on empty");

def replaced = ArrayUtil::WithReplaced(base, 1, 99);
Expect
(
    (replaced[1] == 99) && (base[1] == 20),
    "WithReplaced replaces without touching the original"
);
Expect(ArrayUtil::WithReplaced(base, 0, 5)[0] == 5, "WithReplaced at index 0");
Expect(ArrayUtil::WithReplaced(base, 2, 7)[2] == 7, "WithReplaced at the last index");
def bad_replace = ArrayUtil::WithReplaced(base, 9223372036854775807, 99);
Expect((#bad_replace == 3) && (bad_replace[2] == 30), "WithReplaced beyond the end copies");
Expect(#ArrayUtil::WithReplaced(empty, 0, 99) == 0, "WithReplaced on empty");

def inserted = ArrayUtil::WithInserted(base, 1, 15);
Expect(ArrayUtil::Length(inserted) == 4, "WithInserted grows by one");
Expect
(
    (inserted[0] == 10) && (inserted[1] == 15) && (inserted[2] == 20) && (inserted[3] == 30),
    "WithInserted shifts the tail"
);
Expect(ArrayUtil::WithInserted(base, 0, 1)[0] == 1, "WithInserted at the front");
Expect(ArrayUtil::WithInserted(base, 3, 40)[3] == 40, "WithInserted past the last index appends");
Expect
(
    ArrayUtil::WithInserted(base, 4294967297, 40)[3] == 40,
    "WithInserted with a large positive index appends"
);
Expect
(
    ArrayUtil::WithInserted(base, -4294967295, 1)[0] == 1,
    "WithInserted with a large negative index prepends"
);
Expect(ArrayUtil::Length(ArrayUtil::WithInserted(empty, 0, 1)) == 1, "WithInserted into empty");

def removed = ArrayUtil::WithRemoved(base, 1);
Expect
(
    (ArrayUtil::Length(removed) == 2) && (removed[0] == 10) && (removed[1] == 30),
    "WithRemoved closes the gap"
);
Expect(ArrayUtil::Length(base) == 3, "WithRemoved must not modify the original");
Expect
(
    ArrayUtil::Length(ArrayUtil::WithRemoved([7], 0)) == 0,
    "WithRemoved of the only element gives empty"
);
Expect(ArrayUtil::Length(ArrayUtil::WithRemoved(base, 9)) == 3, "WithRemoved past the end copies");
Expect(ArrayUtil::Length(ArrayUtil::WithRemoved(empty, 0)) == 0, "WithRemoved on empty");
def bad_remove = ArrayUtil::WithRemoved(base, -4294967295);
Expect((#bad_remove == 3) && (bad_remove[0] == 10), "WithRemoved at a negative index copies");

// Inserting across the inline storage boundary and removing back across it.
def words = ["alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel"];
def grown = ArrayUtil::WithInserted(words, 3, "inserted");
def edited = ArrayUtil::WithReplaced(grown, 4, "replaced");
def shrunk = ArrayUtil::WithRemoved(edited, 2);
Expect((#grown == 9) && (grown[3] == "inserted") && (grown[4] == "delta"), "inserting and replacing preserve the first copy");
Expect((#shrunk == 8) && (shrunk[2] == "inserted") && (shrunk[3] == "replaced") && (shrunk[7] == "hotel"), "removal keeps the shifted pointer values");
Expect((#words == 8) && (words[3] == "delta"), "pointer edits preserve the source");

IO::PrintLine(Show(appended));
IO::PrintLine(Show(inserted));
IO::PrintLine(Show(removed));
IO::PrintLine("array_util_with: PASS");
