module HeapExhausted

import
{
	"../../../MarmotPrelude/IO.mmt"
}

// Every text stays reachable from the array, so the collector frees nothing and
// the heap runs out. That used to dereference the null slot the allocator
// returned and was reported as a MemoryAccessViolation that blamed the
// bytecode. A short text takes the largest slot in every build, which a union's
// size does not: Debug builds have wider values.

IO::PrintLine("building");
def texts = [(i as Text) for i in 0..1..20000000];
IO::PrintLine((#texts) as Text);
IO::PrintLine("not reached");
