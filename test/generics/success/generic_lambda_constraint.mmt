module GenericLambdaConstraint
// Test: a where clause on a fn expression.
// Expected: the constraint reaches specialization, so each instantiation
// dispatches to the Convertible instance for its own type.

import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Convertible.mmt" }

def Show = fn<T>(x: T) -> Text where Convertible<T, Text> => x as Text;

IO::PrintLine(Show(42));
IO::PrintLine(Show(3.5));
IO::PrintLine(Show(true));
