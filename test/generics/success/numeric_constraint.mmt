module NumericConstraint
// Generic arithmetic, negation, ranges and bit operations, each allowed by the
// where clause that names the class providing it.

import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Numeric.mmt" }

def Add = fn<T>(a: T, b: T) -> Add::Output<T, T> where Add<T, T> => a + b;

def Negate = fn<T>(value: T) -> Negate::Output<T> where Negate<T> => -value;

def SumRange = fn<T>(start: T, step: T, end: T, total: T) -> T where Numeric<T>, Add<T, T>, Add::Output<T, T> ~ T => {
    def values = [x for x in start..step..end];
    if #values == 0 then total else total + values[0]
};

def Mask = fn<T>(value: T, mask: T) -> T where BitAnd<T, T>, BitAnd::Output<T, T> ~ T, BitXor<T, T>, BitXor::Output<T, T> ~ T, BitOr<T, T>, BitOr::Output<T, T> ~ T => (value & mask) | (value ^ value);

def Doubled = fn<T>(value: T) -> ShiftLeft::Output<T, Int> where ShiftLeft<T, Int> => value << 1;

IO::PrintLine(Add(2, 3) as Text);
IO::PrintLine(Add(1.5, 2.25) as Text);
IO::PrintLine(Negate(4) as Text);
IO::PrintLine(SumRange(3, 1, 6, 10) as Text);
IO::PrintLine(Mask(12, 10) as Text);
IO::PrintLine(Mask(0xF0, 0x3C) as Text);
IO::PrintLine(Doubled(21) as Text);
