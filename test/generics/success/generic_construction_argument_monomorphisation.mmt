module GenericConstructionArgumentMonomorphisation

// A construction in argument position inside a generic function, passed to a forwarder
// with no `where` clause, so monomorphisation rather than the type checker resolves
// `Growable::Append`'s concrete instance. The construction's inferred type once held a
// variable of the call's own instantiation instead of the enclosing definition's
// parameter, and the specialization could not resolve it: this was a failure test
// pinning that gap. The forwarder lives in ../generic_construction_argument_monomorphisation_lib.mmt
// so the call crosses a module boundary.

import
{
	"../../../MarmotPrelude/IO.mmt",
	"../generic_construction_argument_monomorphisation_lib.mmt",
}

type Slot<K, V> = Empty | Occupied(K, V);

def CountSlots = fn<K, V>(slots : Array<Slot<K, V>>) -> Int => #slots;

def FillGeneric = fn<K, V>(slots : Array<Slot<K, V>>) -> Int =>
{
	def appended = GenericConstructionArgumentMonomorphisationLib::AppendTo(slots, Slot::Empty());
	CountSlots(appended)
};

def texts : Array<Slot<Text, Int>> = [];

IO::PrintLine(FillGeneric(texts) as Text);
IO::PrintLine(FillGeneric([Slot::Occupied(1, "one")]) as Text);
