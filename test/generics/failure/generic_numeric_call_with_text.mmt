module GenericNumericCallWithText

// The where clause is checked at the call, so a caller passing Text is told so
// there, rather than the body failing to compile for Text.

import { "../../../MarmotPrelude/Numeric.mmt" }

def Add = fn<T>(a: T, b: T) -> T where Numeric<T> => a + b;

def joined = Add("x", "y");
