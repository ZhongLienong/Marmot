module GenericFunctionBoundToName

// Test: a generic function rebound to a plain name with 'def'.
// Expected: rejected. The binding is a value, so it holds one specialization,
// and nothing at the definition says which; a later use may not decide it.

import
{
	"../../../MarmotPrelude/IO.mmt"
}

def identity = fn<T>(x: T) -> T => x;

def bound = identity;

IO::PrintLine(bound(42) as Text);
