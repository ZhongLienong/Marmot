module NestedGenericShiftSyntax
import { "../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }

type Box<T> =
{
    value: T
};

def nested: Array<Array<Text>> = [["left"], ["right"]];

def boxed = Box(nested);

def shift_rows = fn(value: Int, rows: Array<Array<Text>>) -> Int => value >> (#rows - 1);

IO::PrintLine("nested_generic_shift_syntax: " ++ (shift_rows(8, boxed.value) as Text));
