module CellCrossesWorkerChannel

import
{
	"../../../MarmotPrelude/IO.mmt",
	"../../../MarmotPrelude/Concurrency.mmt"
}

// Sending a cell through a channel, or mapping over cells in parallel, copies
// each cell into the worker that handles it.

def channel : Channel<Ref<Int>> = Concurrency::MakeChannel(1);
def original = ref 5;
channel -> original;
def received = <- channel;
received := 6;
def changed = *received;

def cells = [(ref 1), (ref 2)];
def Double = fn(c: Ref<Int>) -> Int => {
	c := (*c) * 2;
	*c
};
def doubled = Concurrency::ParallelMap(cells, Double, 1);

IO::PrintLine("received " ++ (changed as Text) ++ ", original " ++ (*original as Text));
IO::PrintLine("doubled " ++ (doubled[0] as Text) ++ " " ++ (doubled[1] as Text) ++ ", cells still " ++ ((*cells[0]) as Text) ++ " " ++ ((*cells[1]) as Text));
