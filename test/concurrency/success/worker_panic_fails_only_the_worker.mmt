module WorkerPanicFailsOnlyTheWorker

import
{
	"../../../MarmotPrelude/Concurrency.mmt",
	"../../../MarmotPrelude/Prelude/Result.mmt",
	"../../../MarmotPrelude/Prelude/Panic.mmt",
	"../../../MarmotPrelude/IO.mmt"
}

use Result.{Result}
use Concurrency.{WorkerError}

use Result.{ Result }

// A panic inside a worker used to exit the whole process, taking the joining
// program with it. Exiting from a worker thread would end a program the worker
// only borrows, so the worker fails instead and the joiner receives
// Err(Failed(...)) like any other worker failure.

def Describe = fn(label : Text, result : Result<Int, WorkerError>) -> Unit =>
	match result with
		case Result::Ok(value) => IO::PrintLine(label ++ ": Ok(" ++ (value as Text) ++ ")")
		case Result::Err(WorkerError::Cancelled()) => IO::PrintLine(label ++ ": Err(Cancelled)")
		case Result::Err(WorkerError::Failed(_)) => IO::PrintLine(label ++ ": Err(Failed)");

def Boom = fn(_ignored : Int) -> Int => Panic::Panic("worker panicked");
def Double = fn(n : Int) -> Int => n * 2;

def panicking = Concurrency::Spawn(1, Boom);
Describe("panicking worker", Concurrency::Join(panicking));

// The program is still running, and later workers are unaffected.
def healthy = Concurrency::Spawn(21, Double);
Describe("next worker", Concurrency::Join(healthy));

IO::PrintLine("joiner still running");
