module FunctionThroughChannel
import { "../../../projects/marmotstdlib/MarmotPrelude/Concurrency.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Option.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Result.mmt", "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }

// A channel serializes what it carries, so a function travels through one the way
// it travels to a worker: procedure index plus a copy of its captured values.

def SendScaled = fn(ch: Channel<fn(Int) -> Int>, scale: Int) -> Bool => Concurrency::Send(ch, fn(n: Int) -> Int => n * scale);

def channel: Channel<fn(Int) -> Int> = Concurrency::MakeChannel(1);

SendScaled(channel, 3);

def received = Option::OptionUnwrapOrPanic(Concurrency::Receive(channel), "Channel closed");
IO::PrintLine("received applies: " ++ (received(14) as Text));

// And back out of a worker that was handed the channel.
def worker = Concurrency::Spawn
(
    channel,
    fn(ch: Channel<fn(Int) -> Int>) -> Int =>
    {
        Concurrency::Send(ch, fn(n: Int) -> Int => n + 100);
        0
    }
);

def from_worker = Option::OptionUnwrapOrPanic(Concurrency::Receive(channel), "Channel closed");
IO::PrintLine("from the worker: " ++ (from_worker(5) as Text));
IO::PrintLine("joined: " ++ (Concurrency::JoinedOrPanic(Concurrency::Join(worker)) as Text));
Concurrency::Close(channel);
