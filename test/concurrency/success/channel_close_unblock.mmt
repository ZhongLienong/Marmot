module channel_close_unblock
import { "../../../projects/marmotstdlib/MarmotPrelude/Concurrency.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Option.mmt" }

import { "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt" }
use IO.
{
    PrintLine
}

def Sender = fn(ch: Channel<Text>) -> Int =>
{
    Concurrency::Send(ch, "first");
    Concurrency::Send(ch, "second");
    Concurrency::Close(ch);
    0
};

def ch: Channel<Text> = Concurrency::MakeChannel(2);

def w = Concurrency::Spawn(ch, Sender);

def msg1 = Option::OptionUnwrapOrPanic(Concurrency::Receive(ch), "Missing first message");

def msg2 = Option::OptionUnwrapOrPanic(Concurrency::Receive(ch), "Missing second message");

PrintLine("msg1=[" ++ msg1 ++ "]");
PrintLine("msg2=[" ++ msg2 ++ "]");

def r = Concurrency::JoinedOrPanic(Concurrency::Join(w));
PrintLine("worker_done=true");
PrintLine("drained=" ++ (Option::OptionIsNone(Concurrency::Receive(ch)) as Text));
PrintLine("sent_after_close=" ++ (Concurrency::Send(ch, "late") as Text));
