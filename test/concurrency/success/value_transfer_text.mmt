module value_transfer_text

import { "../../../MarmotPrelude/Concurrency.mmt", "../../../MarmotPrelude/Prelude/Option.mmt", "../../../MarmotPrelude/Prelude/Result.mmt" }

import { "../../../MarmotPrelude/IO.mmt" }
use IO.{PrintLine}

def TextWorker = fn(ch : Channel<Text>) -> Int =>
{
    Concurrency::Send(ch, "hello world");
    Concurrency::Send(ch, "");
    Concurrency::Send(ch, "special chars: !@#$%^&*()");
    Concurrency::Send(ch, "line1\nline2");
    0
};

def ch : Channel<Text> = Concurrency::MakeChannel(4);
def w = Concurrency::Spawn(ch, TextWorker);

def v1 = Option::OptionUnwrapOrPanic(Concurrency::Receive(ch), "Channel closed");
def v2 = Option::OptionUnwrapOrPanic(Concurrency::Receive(ch), "Channel closed");
def v3 = Option::OptionUnwrapOrPanic(Concurrency::Receive(ch), "Channel closed");
def v4 = Option::OptionUnwrapOrPanic(Concurrency::Receive(ch), "Channel closed");

PrintLine("v1=[" ++ v1 ++ "]");
PrintLine("v2=[" ++ v2 ++ "]");
PrintLine("v3=[" ++ v3 ++ "]");
PrintLine("v4=[" ++ v4 ++ "]");

Concurrency::Close(ch);
def r = Concurrency::JoinedOrPanic(Concurrency::Join(w));
