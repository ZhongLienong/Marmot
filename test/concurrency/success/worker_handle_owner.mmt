module WorkerHandleOwner
import { "../../../projects/marmotstdlib/MarmotPrelude/Concurrency.mmt", "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Option.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Result.mmt" }

use Concurrency.
{
    WorkerError
}
use Result.
{
    Result
}

def Show = fn<T>(label: Text, result: Result<T, WorkerError>) -> Unit => match result with
    case Result::Ok(_) => IO::PrintLine(label ++ " succeeded")
    case Result::Err(error) => match error with
        case WorkerError::Cancelled() => IO::PrintLine(label ++ " cancelled")
        case WorkerError::Failed(message) => IO::PrintLine(label ++ " failed: " ++ message);

def Answer = fn() -> Int => 42;

def WaitForAnswer = fn(source: Channel<Int>) -> Int => Option::OptionUnwrapOrPanic(Concurrency::Receive(source), "Missing answer");

def answers: Channel<Int> = Concurrency::MakeChannel(1);

def target = Concurrency::Spawn(answers, WaitForAnswer);

def JoinGlobal = fn() -> Int => Concurrency::JoinedOrPanic(Concurrency::Join(target));

def CancelGlobal = fn() -> Bool => Concurrency::Cancel(target);

def PollGlobal = fn() -> Bool =>
{
    Concurrency::JoinedOrPanic(Concurrency::Join(Concurrency::Spawn((), Answer)));
    Concurrency::IsDone(target)
};

Show("foreign cancel", Concurrency::Join(Concurrency::Spawn((), CancelGlobal)));
Show("foreign poll", Concurrency::Join(Concurrency::Spawn((), PollGlobal)));
Concurrency::Send(answers, 42);
Show("foreign join", Concurrency::Join(Concurrency::Spawn((), JoinGlobal)));
match Concurrency::Join(target) with
    case Result::Ok(value) => IO::PrintLine("owner joined " ++ (value as Text))
    case Result::Err(_) => IO::PrintLine("owner lost the result");
Concurrency::Close(answers);
Show("foreign poll after join", Concurrency::Join(Concurrency::Spawn((), PollGlobal)));
IO::PrintLine("owner sees done=" ++ (Concurrency::IsDone(target) as Text));

def Nested = fn() -> Int => Concurrency::JoinedOrPanic(Concurrency::Join(Concurrency::Spawn((), Answer)));
IO::PrintLine
(
    "nested owner joined " ++ (Concurrency::JoinedOrPanic(Concurrency::Join(Concurrency::Spawn((), Nested))) as Text)
);
