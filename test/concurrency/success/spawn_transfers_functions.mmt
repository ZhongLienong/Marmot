module SpawnTransfersFunctions
import { "../../../projects/marmotstdlib/MarmotPrelude/Concurrency.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Prelude/Result.mmt", "../../../projects/marmotstdlib/MarmotPrelude/IO.mmt", "../../../projects/marmotstdlib/MarmotPrelude/Transferable.mmt" }

// Transferable functions can cross with their captures, including through a
// parameter, a returned value or a field of a transferred record.

def Increment = fn(value: Int) -> Int => value + 1;

// The spawned function is a lambda that captured a local.
def ScaleBy = fn(factor: Int, value: Int) -> Int =>
{
    def worker = Concurrency::Spawn(value, fn(n: Int) -> Int => n * factor);
    Concurrency::JoinedOrPanic(Concurrency::Join(worker))
};
IO::PrintLine("captured: " ++ (ScaleBy(6, 7) as Text));

// The spawned function arrives as a parameter rather than a name.
def RunWith = fn(work: fn(Int) -> Int, value: Int) -> Int where Transferable<fn(Int) -> Int> =>
{
    def worker = Concurrency::Spawn(value, work);
    Concurrency::JoinedOrPanic(Concurrency::Join(worker))
};
IO::PrintLine("parameter: " ++ (RunWith(Increment, 41) as Text));

// A function travels as data, inside the worker's argument.
def RunCallback = fn(callback: fn(Int) -> Int) -> Int => callback(1);

def callback_worker = Concurrency::Spawn(Increment, RunCallback);
IO::PrintLine("argument: " ++ (Concurrency::JoinedOrPanic(Concurrency::Join(callback_worker)) as Text));

// Including inside a record that derives Transferable.
type Payload<F> =
{
    callback: F
}
deriving(Transferable);

def UsePayload = fn() -> Int => {
    def payload = Payload(Increment);
    def worker = Concurrency::Spawn((), fn() -> Int => payload.callback(5));
    Concurrency::JoinedOrPanic(Concurrency::Join(worker))
};
IO::PrintLine("record field: " ++ (UsePayload() as Text));

def MakeCallback = fn<T>(value: T) where Transferable<T> => fn() -> T => value;

def returned = Concurrency::Spawn((), MakeCallback("generic capture"));
IO::PrintLine(Concurrency::JoinedOrPanic(Concurrency::Join(returned)));

def UseLocalReference = fn(value: Int) -> Int => {
    def cell = ref value;
    def callbacks = [fn() -> Int => 0, fn() -> Int => *cell];
    cell := value + 1;
    callbacks[0]() + callbacks[1]()
};

def local_reference = Concurrency::Spawn(10, UseLocalReference);
IO::PrintLine(Concurrency::JoinedOrPanic(Concurrency::Join(local_reference)) as Text);

def RunRecursive = fn(base: Int) -> Int => {
    def AddDown = fn(n: Int) -> Int => if n <= 0 then base else n + AddDown(n - 1);
    Concurrency::JoinedOrPanic(Concurrency::Join(Concurrency::Spawn(4, AddDown)))
};

IO::PrintLine(RunRecursive(10) as Text);
