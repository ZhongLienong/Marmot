module System
import { "./Prelude/Option.mmt", "./Prelude/Result.mmt" }
use Option.
{
    Option
}
use Result.
{
    Result
}
public export { SystemError, Platform, ProcessResult, ProcessOutput, Exit, Sleep, TryGetEnv, SetEnv, CurrentDirectory, TrySetCurrentDirectory, Run, RunProcess, Arguments, CurrentPlatform, CurrentProcessId }

type SystemError = InvalidDirectory(Text) | CommandFailed(Int) | UnknownSystem(Text);

type Platform = Windows | MacOS | Linux | WebAssembly | Unknown(Text);

type ProcessResult =
{
    exit_code: Int
};

type ProcessOutput =
{
    exit_code: Int,
    stdout: Text,
    stderr: Text
};

foreign "MARMOT_FFI_Exit" ExitRaw: fn(Int) -> Never;

foreign "MARMOT_FFI_GetEnv" GetEnvRaw: fn(Text) -> Text from "marmotstdlib";

foreign "MARMOT_FFI_SetEnv" SetEnvRaw: fn(Text, Text) -> Bool from "marmotstdlib";

foreign "MARMOT_FFI_Sleep" SleepRaw: fn(Int) -> Unit;

foreign "MARMOT_FFI_GetCurrentDirectory" GetCurrentDirectoryRaw: fn() -> Text from "marmotstdlib";

foreign "MARMOT_FFI_SetCurrentDirectory" SetCurrentDirectoryRaw: fn(Text) -> Bool from "marmotstdlib";

foreign "MARMOT_FFI_Execute" ExecuteRaw: fn(Text) -> Int from "marmotstdlib";

foreign "MARMOT_FFI_RunProcess" RunProcessRaw: fn(Array<Text>, Text) -> Array<Text> from "marmotstdlib";

foreign "MARMOT_FFI_GetPlatform" GetPlatformRaw: fn() -> Text from "marmotstdlib";

foreign "MARMOT_FFI_GetArguments" GetArgumentsRaw: fn() -> Array<Text>;

foreign "MARMOT_FFI_GetProcessId" GetProcessIdRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetLastSystemErrorKind" GetLastSystemErrorKindRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetLastSystemErrorMessage" GetLastSystemErrorMessageRaw: fn() -> Text from "marmotstdlib";

// Stops execution with the given exit code. In a worker this fails the worker.
def Exit = fn(code: Int) -> Never => ExitRaw(code);

// Suspends the calling thread for the requested milliseconds. Worker cancellation
// interrupts the wait.
def Sleep = fn(milliseconds: Int) -> Unit => SleepRaw(milliseconds);

// Adds the native error message when one is available.
def UnknownSystemContext = fn(context: Text, message: Text) -> Text =>
{
    if message == ""
    then context
    else context ++ ": " ++ message
};

// Maps a native system status to a typed error with the operation's context.
def MakeSystemError = fn(context: Text, error_kind: Int) -> SystemError =>
{
    // Keep the native message available for errors without a dedicated variant.
    def message = GetLastSystemErrorMessageRaw();
    if error_kind == 2
    then SystemError::InvalidDirectory(context)
    else SystemError::UnknownSystem(UnknownSystemContext(context, message))
};

// Reads the preceding native system status to choose between the supplied value and an
// error.
def SystemResultFromStatus = fn<T>(context: Text, value: T) -> Result<T, SystemError> =>
{
    // Read the status before any other native system operation can replace it.
    def error_kind = GetLastSystemErrorKindRaw();
    if error_kind == 0
    then Result::Ok(value)
    else Result::Err(MakeSystemError(context, error_kind))
};

// Returns the process environment variable's value, or None on lookup failure. A set but
// empty variable yields Some with empty text.
def TryGetEnv = fn(name: Text) -> Option<Text> =>
{
    // Look up the value first so the status can distinguish absence from an empty value.
    def value = GetEnvRaw(name);
    if GetLastSystemErrorKindRaw() == 0
    then Option::Some(value)
    else Option::None()
};

// Sets a process environment variable and returns any error from the platform.
def SetEnv = fn(name: Text, value: Text) -> Result<Unit, SystemError> =>
{
    SetEnvRaw(name, value);
    SystemResultFromStatus(name, ())
};

// Returns the process's working directory or an error.
def CurrentDirectory = fn() -> Result<Text, SystemError> =>
{
    // Get the path before checking the status so a failure becomes a typed error.
    def path = GetCurrentDirectoryRaw();
    SystemResultFromStatus("current directory", path)
};

// Changes the process-wide working directory or returns an error.
def TrySetCurrentDirectory = fn(path: Text) -> Result<Unit, SystemError> =>
{
    SetCurrentDirectoryRaw(path);
    SystemResultFromStatus(path, ())
};

// Runs a shell command. A nonzero exit code yields CommandFailed.
def Run = fn(command: Text) -> Result<ProcessResult, SystemError> =>
{
    // Run the command before reading its native status.
    def exit_code = ExecuteRaw(command);
    // Separate failure to invoke the command from a command that exited nonzero.
    def error_kind = GetLastSystemErrorKindRaw();
    if error_kind != 0
    then Result::Err(MakeSystemError(command, error_kind))
    else if exit_code == 0
    then Result::Ok(ProcessResult(exit_code))
    else Result::Err(SystemError::CommandFailed(exit_code))
};

// Runs `arguments[0]`, found on PATH, with the rest as its arguments exactly:
// there is no shell, so nothing in them is interpreted. It runs in `directory`,
// or the current directory when that is empty, with nothing on its input. A
// program that ran is Ok whatever its exit code, with everything it wrote.
def RunProcess = fn(arguments: Array<Text>, directory: Text) -> Result<ProcessOutput, SystemError> => if #arguments == 0
then Result::Err(SystemError::UnknownSystem("RunProcess needs a program to run"))
else
{
    // On success the native result carries the exit code, stdout, and stderr in that order.
    def parts = RunProcessRaw(arguments, directory);
    // Check the status before indexing the native result.
    def error_kind = GetLastSystemErrorKindRaw();
    // Use the working directory for directory errors and the program name for other
    // failures.
    def context = if error_kind == 2
    then directory
    else arguments[0];
    if error_kind != 0
    then Result::Err(MakeSystemError(context, error_kind))
    else Result::Ok(ProcessOutput(parts[0] as Int, parts[1], parts[2]))
};

// What the program was started with: everything after `--` for marmotvm and
// marmot run, everything after its name for a standalone executable.
def Arguments = fn() -> Array<Text> => GetArgumentsRaw();

// Returns the host platform, retaining the native name for an unrecognized platform.
def CurrentPlatform = fn() -> Platform =>
{
    // Map both native WebAssembly names to the same public variant.
    def platform = GetPlatformRaw();
    if platform == "Windows"
    then Platform::Windows()
    else if platform == "macOS"
    then Platform::MacOS()
    else if platform == "Linux"
    then Platform::Linux()
    else if platform == "WebAssembly"
    then Platform::WebAssembly()
    else if platform == "WebAssembly (wasm64)"
    then Platform::WebAssembly()
    else Platform::Unknown(platform)
};

// Returns the ID of the current process.
def CurrentProcessId = fn() -> Int => GetProcessIdRaw();
