module Indexable
public export { Indexable }

class Indexable<C, I>
{
    type Element;
    Get: fn(container: C, index: I) -> Element;
};

instance Indexable<Array<T>, Int>
{
    type Element = T;
    // Reads the array element at a zero-based index. An out-of-range index raises a runtime
    // error.
    def Get = fn(container: Array<T>, index: Int) -> T => container[index];
};
