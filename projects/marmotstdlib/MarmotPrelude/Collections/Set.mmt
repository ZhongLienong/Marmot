module Set
import { "./Map.mmt", "../ArrayUtil.mmt", "../Countable.mmt", "../Equatable.mmt", "../Hashable.mmt", "../Iter.mmt", "../Iterable.mmt", "../Prelude/Option.mmt" }
public export { Set, SetEmpty, SetCount, SetIsEmpty, SetWith, SetWithout, SetHas, SetToArray, SetIter, SetIterNew, SetUnion, SetIntersection, SetDifference }
use Option.
{
    Option
}

// Its own type rather than an alias for Map<T, Unit>: spec section 5 wants a
// Set's Hashable instance not to collapse into the map's.
type Set<T> =
{
    entries: Map::Map<T, Unit>
};

// Creates an empty set.
def SetEmpty = fn<T>() -> Set<T> => Set(Map::Empty());

// Returns the number of distinct elements in constant time.
def SetCount = fn<T>(set: Set<T>) -> Int => Map::Count(set.entries);

// Tests whether the set contains any elements.
def SetIsEmpty = fn<T>(set: Set<T>) -> Bool => Map::IsEmpty(set.entries);

// Returns a set containing value, which counts once even if it was already present.
def SetWith = fn<T>(set: Set<T>, value: T) -> Set<T> where Hashable<T>, Equatable<T> => Set(Map::With(set.entries, value, ()));

// Returns a set without value. An absent value leaves membership unchanged.
def SetWithout = fn<T>(set: Set<T>, value: T) -> Set<T> where Hashable<T>, Equatable<T> => Set(Map::Without(set.entries, value));

// Tests membership using Hashable and Equatable.
def SetHas = fn<T>(set: Set<T>, value: T) -> Bool where Hashable<T>, Equatable<T> => Map::ContainsKey(set.entries, value);

// Returns the elements in the backing map's trie order.
def SetToArray = fn<T>(set: Set<T>) -> Array<T> =>
{
    // Read the backing map entries, whose keys are the set elements.
    def pairs = Map::Entries(set.entries);
    [pairs[slot].key for slot in 0..1..ArrayUtil::Length(pairs)]
};

type SetIter<T> =
{
    values: Array<T>,
    index: Int
};

// Materializes the elements and starts an iterator at the first one.
def SetIterNew = fn<T>(set: Set<T>) -> SetIter<T> => SetIter(SetToArray(set), 0);

instance Iterable<SetIter<T>>
{
    type Item = T;
    // Yields the current element and an iterator at the next position, or None at the end.
    def Next = fn(iter: SetIter<T>) -> Option<(T, SetIter<T>)> => if iter.index >= ArrayUtil::Length(iter.values)
    then Option::None()
    else Option::Some((iter.values[iter.index], SetIter(iter.values, iter.index + 1)));
};

instance Countable<Set<T>>
{
    // Supplies the number of distinct elements for Countable.
    def Count = fn(set: Set<T>) -> Int => Map::Count(set.entries);
};

// Returns the elements of either set, using the right representative of an equal pair.
def SetUnion = fn<T>(left: Set<T>, right: Set<T>) -> Set<T> where Hashable<T>, Equatable<T> => Iter::Fold(SetIterNew(right), left, fn(result: Set<T>, value: T) -> Set<T> => SetWith(result, value));

// Keeps the left elements that are also present in right.
def SetIntersection = fn<T>(left: Set<T>, right: Set<T>) -> Set<T> where Hashable<T>, Equatable<T> => Iter::Fold
(
    SetIterNew(left),
    left,
    fn(result: Set<T>, value: T) -> Set<T> => if SetHas(right, value) then result else SetWithout(result, value)
);

// Keeps the left elements that are absent from right.
def SetDifference = fn<T>(left: Set<T>, right: Set<T>) -> Set<T> where Hashable<T>, Equatable<T> => Iter::Fold(SetIterNew(right), left, fn(result: Set<T>, value: T) -> Set<T> => SetWithout(result, value));
