module Countable
public export { Countable }

class Countable<T>
{
    Count: fn(value: T) -> Int;
};

foreign "MARMOT_FFI_TextLength" TextLength: fn(Text) -> Int;

foreign "MARMOT_FFI_ArrayLength" ArrayLength: fn(Array<T>) -> Int;

instance Countable<Text>
{
    // Counts text in code points.
    def Count = fn(value: Text) -> Int => TextLength(value);
};

instance Countable<Array<T>>
{
    // Counts the elements in the array.
    def Count = fn(value: Array<T>) -> Int => ArrayLength(value);
};
