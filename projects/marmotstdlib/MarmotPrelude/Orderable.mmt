module Orderable
public export { Orderable, Ordering }

type Ordering = Less | Equal | Greater | Unordered;

class Orderable<T>
{
    Compare: fn(a: T, b: T) -> Ordering;
};

instance Orderable<Int>
{
    // Orders signed integers by numeric value.
    def Compare = fn(a: Int, b: Int) -> Ordering => if a < b
    then Ordering::Less()
    else if a > b
    then Ordering::Greater()
    else Ordering::Equal();
};

instance Orderable<Float>
{
    // Orders floats by numeric value, returning Unordered if either value is NaN.
    def Compare = fn(a: Float, b: Float) -> Ordering => if a < b
    then Ordering::Less()
    else if a > b
    then Ordering::Greater()
    else if a == b
    then Ordering::Equal()
    else Ordering::Unordered();
};

instance Orderable<Byte>
{
    // Orders bytes by unsigned numeric value.
    def Compare = fn(a: Byte, b: Byte) -> Ordering => if a < b
    then Ordering::Less()
    else if a > b
    then Ordering::Greater()
    else Ordering::Equal();
};

instance Orderable<Word>
{
    // Orders words by unsigned numeric value.
    def Compare = fn(a: Word, b: Word) -> Ordering => if a < b
    then Ordering::Less()
    else if a > b
    then Ordering::Greater()
    else Ordering::Equal();
};

foreign "MARMOT_FFI_TextCompare" TextCompare: fn(Text, Text) -> Int;

instance Orderable<Text>
{
    // Orders text lexicographically by Unicode code point.
    def Compare = fn(a: Text, b: Text) -> Ordering =>
    {
        // Use the sign of the native UTF-8 comparison to select the ordering.
        def order = TextCompare(a, b);
        if order < 0
        then Ordering::Less()
        else if order > 0
        then Ordering::Greater()
        else Ordering::Equal()
    };
};
