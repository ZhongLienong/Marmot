module DateTime
import { "./TextUtil.mmt", "./Prelude/Option.mmt" }
public export { LocalTimeParts, UtcTimeParts, Duration, NowUnixMillis, NowMonotonicNanos, TimezoneOffsetMinutes, LocalNow, UtcNow, FormatLocal, ParseTimestamp, FormatUtcTimestamp, AddDuration, DurationBetween }
use Option.
{
    Option
}

type LocalTimeParts =
{
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    day_of_week: Int,
    day_of_year: Int,
    timezone_offset_minutes: Int
};

type UtcTimeParts =
{
    year: Int,
    month: Int,
    day: Int,
    hour: Int,
    minute: Int,
    second: Int,
    day_of_week: Int,
    day_of_year: Int
};

type Duration = {
    milliseconds: Int
};

// The native timestamp parser uses the smallest Int as its failure sentinel.
def MinInt: Int = -9223372036854775808;

// Checked duration arithmetic uses the full positive Int range.
def MaxInt: Int = 9223372036854775807;

foreign "MARMOT_FFI_GetTime" GetTimeRaw: fn() -> Float from "marmotstdlib";

foreign "MARMOT_FFI_GetMonotonicNanos" GetMonotonicNanosRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetYear" GetYearRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetMonth" GetMonthRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetDay" GetDayRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetHour" GetHourRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetMinute" GetMinuteRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetSecond" GetSecondRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetDayOfWeek" GetDayOfWeekRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetDayOfYear" GetDayOfYearRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_FormatTime" FormatTimeRaw: fn(Text) -> Text from "marmotstdlib";

foreign "MARMOT_FFI_ParseTimestamp" ParseTimestampRaw: fn(Text) -> Int from "marmotstdlib";

foreign "MARMOT_FFI_FormatUtcTimestamp" FormatUtcTimestampRaw: fn(Int) -> Text from "marmotstdlib";

foreign "MARMOT_FFI_GetTimezoneOffset" GetTimezoneOffsetRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcYear" GetUtcYearRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcMonth" GetUtcMonthRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcDay" GetUtcDayRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcHour" GetUtcHourRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcMinute" GetUtcMinuteRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcSecond" GetUtcSecondRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcDayOfWeek" GetUtcDayOfWeekRaw: fn() -> Int from "marmotstdlib";

foreign "MARMOT_FFI_GetUtcDayOfYear" GetUtcDayOfYearRaw: fn() -> Int from "marmotstdlib";

// Returns wall-clock milliseconds since the Unix epoch.
def NowUnixMillis = fn() -> Int => GetTimeRaw() as Int;

// Returns nanoseconds from a monotonic clock for measuring elapsed time between readings.
def NowMonotonicNanos = fn() -> Int => GetMonotonicNanosRaw();

// Returns the current local time offset from UTC in minutes.
def TimezoneOffsetMinutes = fn() -> Int => GetTimezoneOffsetRaw();

// Reads local calendar and clock fields separately. Sunday is 0 and January 1 is day 1 of
// the year.
def LocalNow = fn() -> LocalTimeParts =>
{
    LocalTimeParts
    (
        GetYearRaw(),
        GetMonthRaw(),
        GetDayRaw(),
        GetHourRaw(),
        GetMinuteRaw(),
        GetSecondRaw(),
        GetDayOfWeekRaw(),
        GetDayOfYearRaw(),
        TimezoneOffsetMinutes()
    )
};

// Reads UTC calendar and clock fields separately. Sunday is 0 and January 1 is day 1 of the
// year.
def UtcNow = fn() -> UtcTimeParts =>
{
    UtcTimeParts
    (
        GetUtcYearRaw(),
        GetUtcMonthRaw(),
        GetUtcDayRaw(),
        GetUtcHourRaw(),
        GetUtcMinuteRaw(),
        GetUtcSecondRaw(),
        GetUtcDayOfWeekRaw(),
        GetUtcDayOfYearRaw()
    )
};

// Formats the current local time using strftime-style directives.
def FormatLocal = fn(format: Text) -> Text => FormatTimeRaw(format);

// Parses YYYY-MM-DDTHH:MM:SS, an optional fraction of one to three digits, and
// Z or a signed HH:MM offset. Returns Unix milliseconds for UTC years 0000–9999.
// Malformed dates, leap seconds, and results outside that year range give None.
def ParseTimestamp = fn(text: Text) -> Option<Int> => if TextUtil::Contains(text, "\0") then Option::None() else
{
    // Validate the entire timestamp before exposing the numeric result.
    def milliseconds = ParseTimestampRaw(text);
    if milliseconds == MinInt then Option::None() else Option::Some(milliseconds)
};

// Formats Unix milliseconds as UTC with exactly three fractional digits.
// Returns None outside UTC years 0000–9999.
def FormatUtcTimestamp = fn(timestamp: Int) -> Option<Text> => {
    // The native formatter yields empty text when the UTC year cannot be represented.
    def text = FormatUtcTimestampRaw(timestamp);
    if text == "" then Option::None() else Option::Some(text)
};

// Adds a signed duration to a timestamp and returns None if the Int would overflow.
def AddDuration = fn(timestamp: Int, duration: Duration) -> Option<Int> => {
    // Select a bound whose subtraction is safe for the sign of the duration.
    def delta = duration.milliseconds;
    if ((delta > 0) && (timestamp > MaxInt - delta)) || ((delta < 0) && (timestamp < MinInt - delta)) then Option::None() else Option::Some(timestamp + delta)
};

// Returns the signed elapsed milliseconds from start to finish, or None on Int overflow.
def DurationBetween = fn(start: Int, finish: Int) -> Option<Duration> => if ((start > 0) && (finish < MinInt + start)) || ((start < 0) && (finish > MaxInt + start)) then Option::None() else Option::Some(Duration(finish - start));
