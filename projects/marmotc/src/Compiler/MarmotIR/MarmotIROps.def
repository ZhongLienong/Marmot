MARMOT_IR_BINARY(SubFloat, Float, Float, Pure, None)
MARMOT_IR_BINARY(MulFloat, Float, Float, Pure, None)
MARMOT_IR_BINARY(DivFloat, Float, Float, Pure, None)
MARMOT_IR_BINARY(ModFloat, Float, Float, Pure, None)
MARMOT_IR_UNARY(NegFloat, Float, Float, Pure, None)
