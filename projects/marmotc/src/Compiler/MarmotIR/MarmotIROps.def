MARMOT_IR_BINARY(SubByte, Byte, Byte, Pure, None)
MARMOT_IR_BINARY(MulByte, Byte, Byte, Pure, None)
MARMOT_IR_BINARY(DivByte, Byte, Byte, Fault, DivisionByZero)
MARMOT_IR_BINARY(ModByte, Byte, Byte, Fault, DivisionByZero)
MARMOT_IR_BINARY(AddWord, Word, Word, Pure, None)
MARMOT_IR_BINARY(SubWord, Word, Word, Pure, None)
MARMOT_IR_BINARY(MulWord, Word, Word, Pure, None)
MARMOT_IR_BINARY(DivWord, Word, Word, Fault, DivisionByZero)
MARMOT_IR_BINARY(ModWord, Word, Word, Fault, DivisionByZero)

MARMOT_IR_BINARY(BitAndInt, Int, Int, Pure, None)
MARMOT_IR_BINARY(BitOrInt, Int, Int, Pure, None)
MARMOT_IR_BINARY(BitXorInt, Int, Int, Pure, None)
MARMOT_IR_UNARY(BitNotInt, Int, Int, Pure, None)
