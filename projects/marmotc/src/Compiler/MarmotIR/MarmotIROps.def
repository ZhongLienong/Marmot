// Every MarmotIR instruction. Include this after defining the macros you need;
// any left undefined expands to nothing.
//
// MARMOT_IR_UNARY(name, operand, result, effect, fault)
// MARMOT_IR_BINARY(name, operand, result, effect, fault)
//     A fixed signature over scalar types, checked by the verifier from here.
// MARMOT_IR_SPECIAL(name, effect, fault)
//     A signature that depends on the operands' types, checked by hand.
// MARMOT_IR_TERMINATOR(name)
//     Ends a block. Defines no value.
//
// `effect` and `fault` are what the builder gives the instruction; a pass may
// weaken them once it proves more, as SCCP does for a non-zero constant divisor.

#ifndef MARMOT_IR_UNARY
#define MARMOT_IR_UNARY(name, operand, result, effect, fault)
#endif
#ifndef MARMOT_IR_BINARY
#define MARMOT_IR_BINARY(name, operand, result, effect, fault)
#endif
#ifndef MARMOT_IR_SPECIAL
#define MARMOT_IR_SPECIAL(name, effect, fault)
#endif
#ifndef MARMOT_IR_TERMINATOR
#define MARMOT_IR_TERMINATOR(name)
#endif

MARMOT_IR_SPECIAL(Const, Pure, None)

MARMOT_IR_BINARY(AddInt, Int, Int, Pure, None)
MARMOT_IR_BINARY(SubInt, Int, Int, Pure, None)
MARMOT_IR_BINARY(MulInt, Int, Int, Pure, None)
MARMOT_IR_BINARY(DivInt, Int, Int, Fault, DivisionByZero)
MARMOT_IR_BINARY(ModInt, Int, Int, Fault, DivisionByZero)
MARMOT_IR_UNARY(NegInt, Int, Int, Pure, None)
