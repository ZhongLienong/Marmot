// Token, class/method name, integer-only, shift.
MARMOT_BINARY_OPERATOR(SINGLE_PLUS, Add, false, false)
MARMOT_BINARY_OPERATOR(SINGLE_MINUS, Subtract, false, false)
MARMOT_BINARY_OPERATOR(STAR, Multiply, false, false)
MARMOT_BINARY_OPERATOR(SLASH, Divide, false, false)
MARMOT_BINARY_OPERATOR(PERCENT, Remainder, false, false)
MARMOT_BINARY_OPERATOR(SINGLE_AMPERSAND, BitAnd, true, false)
MARMOT_BINARY_OPERATOR(SINGLE_BAR, BitOr, true, false)
MARMOT_BINARY_OPERATOR(CARET, BitXor, true, false)
MARMOT_BINARY_OPERATOR(LEFT_SHIFT, ShiftLeft, true, true)
MARMOT_BINARY_OPERATOR(RIGHT_SHIFT, ShiftRight, true, true)
MARMOT_UNARY_OPERATOR(SINGLE_PLUS, Positive, false)
MARMOT_UNARY_OPERATOR(SINGLE_MINUS, Negate, false)
MARMOT_UNARY_OPERATOR(TILDE, BitNot, true)
