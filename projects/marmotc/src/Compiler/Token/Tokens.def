// Token kind, fixed spelling (empty for source-dependent tokens), reserved keyword.

MARMOT_TOKEN(THIN_ARROW, "->", false)
MARMOT_TOKEN(FAT_ARROW, "=>", false)
MARMOT_TOKEN(LEFT_PAREN, "(", false)
MARMOT_TOKEN(RIGHT_PAREN, ")", false)
MARMOT_TOKEN(LEFT_BRACE, "{", false)
MARMOT_TOKEN(RIGHT_BRACE, "}", false)
MARMOT_TOKEN(LEFT_BRACKET, "[", false)
MARMOT_TOKEN(RIGHT_BRACKET, "]", false)
MARMOT_TOKEN(COMMA, ",", false)
MARMOT_TOKEN(SINGLE_DOT, ".", false)
MARMOT_TOKEN(DOUBLE_DOT, "..", false)
MARMOT_TOKEN(SINGLE_SEMICOLON, ";", false)
MARMOT_TOKEN(SINGLE_PLUS, "+", false)
MARMOT_TOKEN(DOUBLE_PLUS, "++", false)
MARMOT_TOKEN(SINGLE_MINUS, "-", false)
MARMOT_TOKEN(LEFT_SHIFT, "<<", false)
MARMOT_TOKEN(RIGHT_SHIFT, ">>", false)
MARMOT_TOKEN(PERCENT, "%", false)
MARMOT_TOKEN(STAR, "*", false)
MARMOT_TOKEN(SLASH, "/", false)
MARMOT_TOKEN(SINGLE_BAR, "|", false)
MARMOT_TOKEN(DOUBLE_BAR, "||", false)
MARMOT_TOKEN(BAR_BRACKET, "|>", false)
MARMOT_TOKEN(CARET, "^", false)
MARMOT_TOKEN(SINGLE_AMPERSAND, "&", false)
MARMOT_TOKEN(DOUBLE_AMPERSAND, "&&", false)
MARMOT_TOKEN(BANG, "!", false)
MARMOT_TOKEN(BANG_EQUAL, "!=", false)
MARMOT_TOKEN(SINGLE_EQUAL, "=", false)
MARMOT_TOKEN(DOUBLE_EQUAL, "==", false)
MARMOT_TOKEN(RIGHT_ANGLE, ">", false)
MARMOT_TOKEN(GREATER_EQUAL, ">=", false)
MARMOT_TOKEN(LEFT_ANGLE, "<", false)
MARMOT_TOKEN(LESS_EQUAL, "<=", false)
MARMOT_TOKEN(SINGLE_COLON, ":", false)
MARMOT_TOKEN(DOUBLE_COLON, "::", false)
MARMOT_TOKEN(COLON_EQUAL, ":=", false)
MARMOT_TOKEN(TILDE, "~", false)
MARMOT_TOKEN(HASH, "#", false)

// Contextual prefix form; lexed as an identifier so existing names still work.
MARMOT_TOKEN(REF, "ref", false)

MARMOT_TOKEN(IDENTIFIER_LITERAL, "", false)
MARMOT_TOKEN(TEXT_LITERAL, "", false)
MARMOT_TOKEN(FLOAT_LITERAL, "", false)
MARMOT_TOKEN(INTEGER_LITERAL, "", false)

MARMOT_TOKEN(ELSE, "else", true)
MARMOT_TOKEN(FALSE, "false", true)
MARMOT_TOKEN(FUNCTION, "fn", true)
MARMOT_TOKEN(FOR, "for", true)
MARMOT_TOKEN(IN, "in", true)
MARMOT_TOKEN(IF, "if", true)
MARMOT_TOKEN(TRUE, "true", true)
MARMOT_TOKEN(DEF, "def", true)
MARMOT_TOKEN(IMPORT, "import", true)
MARMOT_TOKEN(AS, "as", true)
MARMOT_TOKEN(FOREIGN, "foreign", true)
MARMOT_TOKEN(CASE, "case", true)
MARMOT_TOKEN(MATCH, "match", true)
MARMOT_TOKEN(THEN, "then", true)
MARMOT_TOKEN(WITH, "with", true)
MARMOT_TOKEN(MODULE, "module", true)
MARMOT_TOKEN(EXPORT, "export", true)
MARMOT_TOKEN(PUBLIC, "public", true)
MARMOT_TOKEN(PRIVATE, "private", true)
MARMOT_TOKEN(USE, "use", true)
MARMOT_TOKEN(CLASS, "class", true)
MARMOT_TOKEN(INSTANCE, "instance", true)
MARMOT_TOKEN(WHERE, "where", true)
MARMOT_TOKEN(TYPE, "type", true)
MARMOT_TOKEN(ALIAS, "alias", true)
MARMOT_TOKEN(DERIVING, "deriving", true)

MARMOT_TOKEN(FLOAT, "Float", true)
MARMOT_TOKEN(INTEGER, "Int", true)
MARMOT_TOKEN(BYTE, "Byte", true)
MARMOT_TOKEN(WORD, "Word", true)
MARMOT_TOKEN(TEXT, "Text", true)
MARMOT_TOKEN(BOOL, "Bool", true)
MARMOT_TOKEN(UNIT, "Unit", true)
MARMOT_TOKEN(ARRAY, "Array", true)
MARMOT_TOKEN(NEVER, "Never", true)
MARMOT_TOKEN(RANGE, "Range", true)
MARMOT_TOKEN(WORKER, "Worker", true)
MARMOT_TOKEN(CHANNEL_TYPE, "Channel", true)

MARMOT_TOKEN(WHITESPACE, "", false)
MARMOT_TOKEN(LINE_COMMENT, "", false)
MARMOT_TOKEN(BLOCK_COMMENT, "", false)
MARMOT_TOKEN(END_OF_FILE, "", false)
