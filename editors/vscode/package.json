{
  "name": "marmot-lang",
  "displayName": "Marmot Language Support",
  "description": "Syntax highlighting and compiler diagnostics for Marmot.",
  "version": "0.1.0",
  "publisher": "marmot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhongLienong/Marmot.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Diagnostics run the Marmot project tool and require Workspace Trust.",
      "restrictedConfigurations": [
        "marmot.executablePath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "marmot",
        "aliases": [
          "Marmot",
          "marmot"
        ],
        "extensions": [
          ".mmt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "marmot",
        "scopeName": "source.marmot",
        "path": "./syntaxes/marmot.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Marmot",
      "properties": {
        "marmot.executablePath": {
          "type": "string",
          "default": "marmot",
          "scope": "resource",
          "description": "Path to the Marmot project tool. By default, VS Code looks for marmot on PATH."
        }
      }
    }
  }
}
