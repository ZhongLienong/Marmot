{
  "name": "marmot-lang",
  "displayName": "Marmot Language Support",
  "description": "Syntax highlighting, formatting, live diagnostics, and run commands for Marmot.",
  "version": "0.4.0",
  "publisher": "marmot",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhongLienong/Marmot.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "language-configuration.json",
    "syntaxes/",
    "node_modules/"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Formatting, diagnostics, and run commands use the Marmot project tool and require Workspace Trust.",
      "restrictedConfigurations": [
        "marmot.executablePath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "marmot",
        "aliases": [
          "Marmot",
          "marmot"
        ],
        "extensions": [
          ".mmt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "marmot",
        "scopeName": "source.marmot",
        "path": "./syntaxes/marmot.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "marmot.runFile",
        "title": "Run File",
        "category": "Marmot",
        "icon": "$(play)",
        "enablement": "isWorkspaceTrusted && processExecutionSupported"
      },
      {
        "command": "marmot.runProject",
        "title": "Run Project",
        "category": "Marmot",
        "enablement": "isWorkspaceTrusted && processExecutionSupported"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "marmot.runFile",
          "when": "resourceLangId == marmot && resourceScheme == file"
        },
        {
          "command": "marmot.runProject",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/title": [
        {
          "command": "marmot.runFile",
          "when": "resourceLangId == marmot && resourceScheme == file && isWorkspaceTrusted && processExecutionSupported",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Marmot",
      "properties": {
        "marmot.executablePath": {
          "type": "string",
          "default": "marmot",
          "scope": "resource",
          "description": "Path to the Marmot project tool. By default, VS Code looks for marmot on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
