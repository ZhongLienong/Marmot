{
  "name": "Marmot",
  "scopeName": "source.marmot",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#import"
    },
    {
      "include": "#moduleDecl"
    },
    {
      "include": "#functionDecl"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functionCall"
    },
    {
      "include": "#typeAnnotations"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.marmot",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.marmot",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.marmot",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.marmot",
              "match": "\\\\(?:[nrtbf0\\\\\"]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            },
            {
              "name": "invalid.illegal.escape.marmot",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.marmot",
          "match": "\\b(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|\\d+\\.\\d+|\\d+)\\b"
        },
        {
          "name": "constant.language.boolean.marmot",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.marmot",
          "match": "\\b(?:else|fn|for|in|if|def|import|as|foreign|case|match|then|with|module|export|public|private|use|class|instance|where|type|alias|deriving)\\b"
        },
        {
          "name": "keyword.other.marmot",
          "match": "\\bref\\b(?=\\s+[\\w(\\[{\"*#!~-])|\\bfrom\\b(?=\\s*\")"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.marmot",
          "match": "\\b(?:Float|Int|Byte|Word|Text|Bool|Unit|Array|Never|Range|Channel|Worker|Ref)\\b"
        }
      ]
    },
    "import": {
      "begin": "\\b(import)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.marmot" },
        "2": { "name": "keyword.operator.marmot" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "keyword.operator.marmot" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "name": "string.unquoted.import.marmot",
          "match": "<[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*>"
        },
        { "include": "#operators" }
      ]
    },
    "moduleDecl": {
      "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*\\.\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.control.marmot" },
        "2": { "name": "entity.name.namespace.marmot" }
      }
    },
    "functionDecl": {
      "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=\\s*fn\\b)",
      "captures": {
        "1": { "name": "keyword.control.marmot" },
        "2": { "name": "entity.name.function.marmot" }
      }
    },
    "functionCall": {
      "name": "entity.name.function.call.marmot",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "typeAnnotations": {
      "patterns": [
        {
          "name": "punctuation.separator.annotation.marmot",
          "match": ":(?![:=])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.marmot",
          "match": "(?:\\|>|::|:=|\\.\\.|=>|->|==|!=|<=|>=|<<|>>|\\+\\+|&&|\\|\\||[+\\-*/%&|^~=<>!#.,;:{}()\\[\\]])"
        }
      ]
    }
  }
}
