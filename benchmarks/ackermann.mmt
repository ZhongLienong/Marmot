module Ackermann

import
{
	"../MarmotPrelude/IO.mmt",
	"../MarmotPrelude/DateTime.mmt"
}

def Ackermann = fn(m : Int, n : Int) -> Int =>
{
	if m == 0
	then n + 1
	else
	{
		if n == 0
		then Ackermann(m - 1, 1)
		else Ackermann(m - 1, Ackermann(m, n - 1))
	}
};

def start = DateTime::NowUnixMillis();

def result = Ackermann(3, 5);

def end = DateTime::NowUnixMillis();

IO::PrintLine("Ackermann(3, 5): " ++ (result as Text) ++ " benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
