module StrConcat

import
{
	"../MarmotPrelude/IO.mmt",
	"../MarmotPrelude/DateTime.mmt",
	"../MarmotPrelude/TextUtil.mmt"
}

// v2 port: `test_string = test_string ++ "a"` in a loop is now a tail-recursive
// walk carrying the text. Each step still copies the accumulated text, which is
// what this benchmark has always measured.
def Build = fn(count : Int, limit : Int, acc : Text) -> Text =>
	if count >= limit then acc else Build(count + 1, limit, acc ++ "a");

def start = DateTime::NowUnixMillis();

def test_string = Build(0, 10000, "");

def end = DateTime::NowUnixMillis();

IO::PrintLine("String manipulation (length " ++ (TextUtil::Length(test_string) as Text) ++ ") benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
