module BinarySearch

import
{
	"../MarmotPrelude/IO.mmt",
	"../MarmotPrelude/DateTime.mmt"
}

def BinarySearch = fn(arr : Array<Int>, target : Int, low : Int, high : Int) -> Int =>
{
	if low > high
	then -1
	else
	{
		def mid = low + ((high - low) / 2);
		def mid_val = arr[mid];

		if mid_val == target
		then mid
		else
		{
			if mid_val > target
			then BinarySearch(arr, target, low, mid - 1)
			else BinarySearch(arr, target, mid + 1, high)
		}
	}
};

// v2 port: the search loop assigned to a counter and an index; it is now a
// tail-recursive walk carrying both.
def CountFound = fn(arr : Array<Int>, search : Int, searches : Int, found_count : Int) -> Int =>
{
	if search >= searches
	then found_count
	else
	{
		def target = (search * 7) % 100000;
		def result = BinarySearch(arr, target, 0, #arr - 1);
		CountFound(arr, search + 1, searches, if result != -1 then found_count + 1 else found_count)
	}
};

def start = DateTime::NowUnixMillis();

// v2 port: formerly built by in-place Append in a loop; a comprehension builds it now.
def sorted_array = [value for value in 0..1..100000];

def found_count = CountFound(sorted_array, 0, 10000, 0);

def end = DateTime::NowUnixMillis();

IO::PrintLine("Binary search (10000 searches in 100000 elements): " ++ (found_count as Text) ++ " found, benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
