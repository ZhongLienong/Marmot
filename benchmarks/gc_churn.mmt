module GCChurn

import
{
	"../MarmotPrelude/IO.mmt",
	"../MarmotPrelude/DateTime.mmt",
	"../MarmotPrelude/Prelude/List.mmt"
}

use List.{List, ListReverse, ListToArray}

// v2 port. What is preserved: a long-lived keeper of ~300,000 distinct texts
// that every collection must account for, and a churn phase of 800,000
// iterations of short-lived text and array allocation.
//
// What could not be preserved: the original wrote a fresh text into the old
// keeper array every 1000 iterations (`keeper[...] = fresh`) to exercise the
// write barrier and remembered set with old-to-young edges. A v2 program has no
// in-place writes, so it cannot make that edge explicitly. The fresh texts are
// instead kept in a young cons list and copied into a new keeper once at the
// end, which yields the same final checksum. (The runtime's own old-to-young
// writes, from comprehension appends and in-place `++`, are covered by
// test/gc/comprehension_write_barrier and test/gc/extend_write_barrier.)

def Churn = fn(i : Int, limit : Int, fresh : List<Text>) -> List<Text> =>
{
	if i >= limit
	then fresh
	else
	{
		// Four texts plus the array holding them, formerly four in-place Appends.
		def first = "churn-" ++ (i as Text);
		def second = first ++ "-x";
		def third = second ++ "-y";
		def scratch = [first, second, third, third ++ "-z"];

		Churn(i + 1, limit, if (i % 1000) == 0 then List::Cons("fresh-" ++ (i as Text) ++ "-" ++ scratch[3], fresh) else fresh)
	}
};

def Main = fn() -> Unit =>
{
	def start = DateTime::NowUnixMillis();

	def pad = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-keeper-record-payload-";
	def keeper = [pad ++ (k as Text) for k in 0..1..300000];

	// The churn wrote fresh text number n into keeper[n % 300000]; n stays below
	// 800, so each write lands in a distinct slot.
	def fresh = ListToArray(ListReverse(Churn(0, 800000, List::Nil())));
	def final_keeper = [if slot < #fresh then fresh[slot] else keeper[slot] for slot in 0..1..(#keeper)];

	def end = DateTime::NowUnixMillis();

	IO::PrintLine("GC churn benchmark took " ++ ((end - start) as Text) ++ " milliseconds");
	IO::PrintLine("checksum: keeper_len=" ++ ((#final_keeper) as Text) ++ " keeper[0]=" ++ final_keeper[0] ++ " keeper[299999]=" ++ final_keeper[299999]);
};

Main();
