// Every bytecode instruction, in encoding order:
//   MARMOT_OPCODE(name, length)
// where length is the whole instruction in bytes, the opcode included. The
// position of an entry is its byte value in .mmc files, so inserting,
// removing or reordering entries needs an MbcFormatVersion bump; appending
// does not. The enum, OpCodeTable (lengths and names), the linker, the code
// generator and the disassembler all read this one list.

// Constants and Literals
MARMOT_OPCODE(LOAD_STRING, 2)
MARMOT_OPCODE(LOAD_STRING_WIDE, 3)
MARMOT_OPCODE(INTEGER_CONSTANT, 9)
MARMOT_OPCODE(FLOAT_CONSTANT, 9)
MARMOT_OPCODE(BYTE_CONSTANT, 2)
MARMOT_OPCODE(WORD_CONSTANT, 9)
MARMOT_OPCODE(OP_UNIT, 1)
MARMOT_OPCODE(OP_TRUE, 1)
MARMOT_OPCODE(OP_FALSE, 1)           // Small integer constants (optimization for common values)
MARMOT_OPCODE(INT_MINUS_1, 1)
MARMOT_OPCODE(INT_0, 1)
MARMOT_OPCODE(INT_1, 1)
MARMOT_OPCODE(INT_2, 1)
MARMOT_OPCODE(INT_3, 1)
MARMOT_OPCODE(INT_4, 1)
MARMOT_OPCODE(INT_5, 1)
MARMOT_OPCODE(INT_10, 1)             // Array Operations
MARMOT_OPCODE(CREATE_ARRAY, 4)
MARMOT_OPCODE(CREATE_TUPLE, 4)
MARMOT_OPCODE(GET_ARRAY, 1)
MARMOT_OPCODE(GET_TUPLE, 1)
MARMOT_OPCODE(UNPACK_TUPLE, 1)
MARMOT_OPCODE(ADD_BACK_ARRAY, 1)
MARMOT_OPCODE(GET_ARRAY_LENGTH, 1)   // Range Operations
MARMOT_OPCODE(CREATE_INT_RANGE, 1)
MARMOT_OPCODE(CREATE_FLOAT_RANGE, 1)
MARMOT_OPCODE(GET_RANGE_START, 1)
MARMOT_OPCODE(GET_RANGE_END, 1)
MARMOT_OPCODE(GET_RANGE_STEP, 1)     // Atomic type casting
MARMOT_OPCODE(INT_TO_FLOAT, 1)
MARMOT_OPCODE(TEXT_TO_FLOAT, 1)
MARMOT_OPCODE(FLOAT_TO_INT, 1)
MARMOT_OPCODE(TEXT_TO_INT, 1)
MARMOT_OPCODE(FLOAT_TO_TEXT, 1)
MARMOT_OPCODE(INT_TO_TEXT, 1)
MARMOT_OPCODE(WORD_TO_TEXT, 1)
MARMOT_OPCODE(BYTE_TO_INT, 1)
MARMOT_OPCODE(INT_TO_BYTE, 1)
MARMOT_OPCODE(BYTE_TO_WORD, 1)
MARMOT_OPCODE(WORD_TO_BYTE, 1)
MARMOT_OPCODE(WORD_TO_INT, 1)
MARMOT_OPCODE(INT_TO_WORD, 1)
MARMOT_OPCODE(BYTE_TO_FLOAT, 1)
MARMOT_OPCODE(FLOAT_TO_BYTE, 1)
MARMOT_OPCODE(WORD_TO_FLOAT, 1)
MARMOT_OPCODE(FLOAT_TO_WORD, 1)      // Bit Operations
MARMOT_OPCODE(LEFT_SHIFT, 1)
MARMOT_OPCODE(RIGHT_SHIFT, 1)
MARMOT_OPCODE(LEFT_SHIFT_BYTE, 1)
MARMOT_OPCODE(RIGHT_SHIFT_BYTE, 1)
MARMOT_OPCODE(LEFT_SHIFT_WORD, 1)
MARMOT_OPCODE(RIGHT_SHIFT_WORD, 1)
MARMOT_OPCODE(BITWISE_AND, 1)
MARMOT_OPCODE(BITWISE_OR, 1)
MARMOT_OPCODE(BITWISE_XOR, 1)
MARMOT_OPCODE(BITWISE_NOT, 1)        // Arithmetic Operations
MARMOT_OPCODE(ADD_FLOAT, 1)
MARMOT_OPCODE(SUBTRACT_FLOAT, 1)
MARMOT_OPCODE(MULTIPLY_FLOAT, 1)
MARMOT_OPCODE(DIVIDE_FLOAT, 1)
MARMOT_OPCODE(MODULO_FLOAT, 1)
MARMOT_OPCODE(ADD_INTEGER, 1)
MARMOT_OPCODE(SUBTRACT_INTEGER, 1)
MARMOT_OPCODE(MULTIPLY_INTEGER, 1)
MARMOT_OPCODE(DIVIDE_INTEGER, 1)
MARMOT_OPCODE(MODULO_INTEGER, 1)
MARMOT_OPCODE(ADD_BYTE, 1)
MARMOT_OPCODE(SUBTRACT_BYTE, 1)
MARMOT_OPCODE(MULTIPLY_BYTE, 1)
MARMOT_OPCODE(DIVIDE_BYTE, 1)
MARMOT_OPCODE(MODULO_BYTE, 1)
MARMOT_OPCODE(ADD_WORD, 1)
MARMOT_OPCODE(SUBTRACT_WORD, 1)
MARMOT_OPCODE(MULTIPLY_WORD, 1)
MARMOT_OPCODE(DIVIDE_WORD, 1)
MARMOT_OPCODE(MODULO_WORD, 1)        // Concatenations
MARMOT_OPCODE(CONCAT_ARRAY, 1)
MARMOT_OPCODE(CONCAT_TEXT, 1)        // Compound Assignment Operations
MARMOT_OPCODE(ADD_ASSIGN_INT, 1)
MARMOT_OPCODE(SUB_ASSIGN_INT, 1)     // Comparison Operations
MARMOT_OPCODE(EQUAL_FLOAT, 1)
MARMOT_OPCODE(NOT_EQUAL_FLOAT, 1)
MARMOT_OPCODE(GREATER_FLOAT, 1)
MARMOT_OPCODE(GREATER_EQUAL_FLOAT, 1)
MARMOT_OPCODE(LESS_FLOAT, 1)
MARMOT_OPCODE(LESS_EQUAL_FLOAT, 1)
MARMOT_OPCODE(EQUAL_INTEGER, 1)
MARMOT_OPCODE(NOT_EQUAL_INTEGER, 1)
MARMOT_OPCODE(GREATER_INTEGER, 1)
MARMOT_OPCODE(GREATER_EQUAL_INTEGER, 1)
MARMOT_OPCODE(LESS_INTEGER, 1)
MARMOT_OPCODE(LESS_EQUAL_INTEGER, 1)
MARMOT_OPCODE(EQUAL_BYTE, 1)
MARMOT_OPCODE(NOT_EQUAL_BYTE, 1)
MARMOT_OPCODE(GREATER_BYTE, 1)
MARMOT_OPCODE(GREATER_EQUAL_BYTE, 1)
MARMOT_OPCODE(LESS_BYTE, 1)
MARMOT_OPCODE(LESS_EQUAL_BYTE, 1)
MARMOT_OPCODE(EQUAL_WORD, 1)
MARMOT_OPCODE(NOT_EQUAL_WORD, 1)
MARMOT_OPCODE(GREATER_WORD, 1)
MARMOT_OPCODE(GREATER_EQUAL_WORD, 1)
MARMOT_OPCODE(LESS_WORD, 1)
MARMOT_OPCODE(LESS_EQUAL_WORD, 1)
MARMOT_OPCODE(EQUAL_TEXT, 1)         // Logical Operations
MARMOT_OPCODE(NOT, 1)                // UnaryPrefix Operations
MARMOT_OPCODE(NEGATE_FLOAT, 1)
MARMOT_OPCODE(NEGATE_INTEGER, 1)     // Control Flow
MARMOT_OPCODE(JUMP_IF_FALSE, 3)
MARMOT_OPCODE(JUMP_IF_TRUE, 3)
MARMOT_OPCODE(JUMP, 3)
MARMOT_OPCODE(JUMP_BACK, 3)
MARMOT_OPCODE(IF_INTEGER_LESS, 3)
MARMOT_OPCODE(IF_INTEGER_LESS_EQUAL, 3)
MARMOT_OPCODE(IF_INTEGER_GREATER, 3)
MARMOT_OPCODE(IF_INTEGER_GREATER_EQUAL, 3)
MARMOT_OPCODE(IF_INTEGER_EQUAL, 3)
MARMOT_OPCODE(IF_INTEGER_NOT_EQUAL, 3)
MARMOT_OPCODE(IF_FLOAT_LESS, 3)
MARMOT_OPCODE(IF_FLOAT_LESS_EQUAL, 3)
MARMOT_OPCODE(IF_FLOAT_GREATER, 3)
MARMOT_OPCODE(IF_FLOAT_GREATER_EQUAL, 3)
MARMOT_OPCODE(IF_FLOAT_EQUAL, 3)
MARMOT_OPCODE(IF_FLOAT_NOT_EQUAL, 3) // Match
MARMOT_OPCODE(LOAD_TAG, 1)
MARMOT_OPCODE(GET_TAG, 1)
MARMOT_OPCODE(SET_TAG, 2)            // Callable
MARMOT_OPCODE(CALL_FOREIGN, 3)
MARMOT_OPCODE(CALL_FOREIGN_INDEXED, 4)
MARMOT_OPCODE(CALL, 2)
MARMOT_OPCODE(CALL_0, 1)
MARMOT_OPCODE(CALL_1, 1)
MARMOT_OPCODE(CALL_2, 1)
MARMOT_OPCODE(CALL_3, 1)
MARMOT_OPCODE(CALL_PROC, 3)
MARMOT_OPCODE(CALL_PROC_0, 2)
MARMOT_OPCODE(CALL_PROC_1, 2)
MARMOT_OPCODE(CALL_PROC_2, 2)
MARMOT_OPCODE(CALL_PROC_3, 2)
MARMOT_OPCODE(CALL_GLOBAL, 3)
MARMOT_OPCODE(CALL_GLOBAL_WIDE, 4)
MARMOT_OPCODE(TAIL_CALL, 2)
MARMOT_OPCODE(CONSTRUCT_STRUCT, 2)
MARMOT_OPCODE(CONSTRUCT_UNION, 2)
MARMOT_OPCODE(LOAD_EMPTY_UNION, 2)   // Closure Operations
MARMOT_OPCODE(MAKE_CLOSURE, 2)
MARMOT_OPCODE(BIND_CAPTURES, 2)
MARMOT_OPCODE(MAKE_FUNCTION, 2)
MARMOT_OPCODE(DEFINE_GLOBAL, 2)
MARMOT_OPCODE(GET_GLOBAL, 2)
MARMOT_OPCODE(SET_GLOBAL, 2)
MARMOT_OPCODE(GET_LOCAL, 2)
MARMOT_OPCODE(SET_LOCAL, 2)
MARMOT_OPCODE(GET_LOCAL_CELL, 2)
MARMOT_OPCODE(SET_LOCAL_CELL, 2)
MARMOT_OPCODE(GET_CELL, 2)
MARMOT_OPCODE(SET_CELL, 2)           // Cell<T>: operate on a cell value on the stack, not on a captured local.
MARMOT_OPCODE(MAKE_CELL, 1)
MARMOT_OPCODE(READ_CELL, 1)
MARMOT_OPCODE(WRITE_CELL, 1)         // Wide variable operations (for indices > 255)
MARMOT_OPCODE(DEFINE_GLOBAL_WIDE, 3)
MARMOT_OPCODE(GET_GLOBAL_WIDE, 3)
MARMOT_OPCODE(SET_GLOBAL_WIDE, 3)
MARMOT_OPCODE(GET_LOCAL_WIDE, 3)
MARMOT_OPCODE(SET_LOCAL_WIDE, 3)
MARMOT_OPCODE(GET_LOCAL_CELL_WIDE, 3)
MARMOT_OPCODE(SET_LOCAL_CELL_WIDE, 3)
MARMOT_OPCODE(GET_CELL_WIDE, 3)
MARMOT_OPCODE(SET_CELL_WIDE, 3)      // Struct Operations
MARMOT_OPCODE(GET_MEMBER, 2)         // Stack Operations
MARMOT_OPCODE(POP, 1)
MARMOT_OPCODE(DUP, 1)
MARMOT_OPCODE(SWAP, 1)
MARMOT_OPCODE(POP_LOCAL_SCOPE, 2)
MARMOT_OPCODE(POP_VALUES, 2)
MARMOT_OPCODE(POP_BLOCK_SCOPE, 2)
MARMOT_OPCODE(POP_MATCH_SCOPE, 2)    // Return
MARMOT_OPCODE(RETURN, 1)
MARMOT_OPCODE(HALT, 1)               // Placeholder
MARMOT_OPCODE(PUSH_PLACEHOLDER, 1)   // Concurrency
MARMOT_OPCODE(SPAWN_WORKER, 2)
MARMOT_OPCODE(JOIN_WORKER, 5)
MARMOT_OPCODE(CHANNEL_CREATE, 1)
MARMOT_OPCODE(CHANNEL_SEND, 1)
MARMOT_OPCODE(CHANNEL_RECEIVE, 1)
MARMOT_OPCODE(CHANNEL_CLOSE, 1)
MARMOT_OPCODE(WORKER_IS_DONE, 1)
MARMOT_OPCODE(WORKER_CANCEL, 1)      // In-place concatenation
MARMOT_OPCODE(EXTEND_ARRAY, 1)
MARMOT_OPCODE(EXTEND_TEXT, 1)        // Fused local-operand superinstructions. Byte layouts are padded so
// RewriteEmittedLocalOps can rewrite them into the unfused sequence in
// place when a local is promoted to a cell.
MARMOT_OPCODE(ADD_LOCAL_INT, 6)      // [op][local][imm8][pad][pad][local]           local += imm, push result
MARMOT_OPCODE(PUSH_LOCAL_SUB_INT, 4) // [op][local][imm8][pad]                       push local - imm
MARMOT_OPCODE(IF_LOCAL_LE_INT, 6)    // [op][local][imm8][pad][off_lo][off_hi]       branch if !(local <= imm)
MARMOT_OPCODE(IF_LOCAL_GE_LOCAL, 7)  // [op][left][pad][right][pad][off_lo][off_hi]  branch if !(left >= right)
MARMOT_OPCODE(GET_LOCAL2, 4)         // [op][first][pad][second]                     push two locals
