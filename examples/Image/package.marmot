[package]
name = "Image"
version = "0.1.0"
authors = ["jk381"]
description = "Image IO bindings for Marmot using Rust."
license = "MIT"
marmot_version = ">=1.0.0"

[package.modules]
main = "Image.mmt"
exports = ["Image"]

[ffi]
enabled = true
library_name = "marmot_image"
thread_safe = true

[ffi.functions]
"MIDORI_FFI_Image_ReadInfo" = "marmot_image_read_info"
"MIDORI_FFI_Image_ReadRGBA" = "marmot_image_read_rgba"
"MIDORI_FFI_Image_WriteRGBA" = "marmot_image_write_rgba"
