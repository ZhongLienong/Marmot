module Math
import { "Orderable.mmt" }
public export { Pi, E, Tau, SquareRoot, Abs, Pow, Exp, Log, Log10, Log2, Sin, Cos, Tan, Asin, Acos, Atan, Atan2, Sinh, Cosh, Tanh, Floor, Ceil, Round, Trunc, Min, Max, Clamp, Sign, Fmod, Hypot, Random, RandomInt, RandomFloat, ToRadians, ToDegrees, IsNaN, IsInf, IsFinite }
def Pi: Float = 3.14159265358979323846;
def E: Float = 2.71828182845904523536;
def Tau: Float = 6.28318530717958647692;
foreign "MIDORI_FFI_SquareRoot" SquareRoot: fn(Float) -> Float;
foreign "MIDORI_FFI_Abs" Abs: fn(Float) -> Float;
foreign "MIDORI_FFI_Pow" Pow: fn(Float, Float) -> Float;
foreign "MIDORI_FFI_Exp" Exp: fn(Float) -> Float;
foreign "MIDORI_FFI_Log" Log: fn(Float) -> Float;
foreign "MIDORI_FFI_Log10" Log10: fn(Float) -> Float;
foreign "MIDORI_FFI_Log2" Log2: fn(Float) -> Float;
foreign "MIDORI_FFI_Sin" Sin: fn(Float) -> Float;
foreign "MIDORI_FFI_Cos" Cos: fn(Float) -> Float;
foreign "MIDORI_FFI_Tan" Tan: fn(Float) -> Float;
foreign "MIDORI_FFI_Asin" Asin: fn(Float) -> Float;
foreign "MIDORI_FFI_Acos" Acos: fn(Float) -> Float;
foreign "MIDORI_FFI_Atan" Atan: fn(Float) -> Float;
foreign "MIDORI_FFI_Atan2" Atan2: fn(Float, Float) -> Float;
foreign "MIDORI_FFI_Sinh" Sinh: fn(Float) -> Float;
foreign "MIDORI_FFI_Cosh" Cosh: fn(Float) -> Float;
foreign "MIDORI_FFI_Tanh" Tanh: fn(Float) -> Float;
foreign "MIDORI_FFI_Floor" Floor: fn(Float) -> Float;
foreign "MIDORI_FFI_Ceil" Ceil: fn(Float) -> Float;
foreign "MIDORI_FFI_Round" Round: fn(Float) -> Float;
foreign "MIDORI_FFI_Trunc" Trunc: fn(Float) -> Float;
def Min = fn < T >(a: T, b: T) -> T where Orderable < T > => if b < a then b else a;
def Max = fn < T >(a: T, b: T) -> T where Orderable < T > => if a < b then b else a;
def Clamp = fn < T >(value: T, low: T, high: T) -> T where Orderable < T > => if value < low then low else if high < value then high else value;
foreign "MIDORI_FFI_Sign" Sign: fn(Float) -> Float;
foreign "MIDORI_FFI_Fmod" Fmod: fn(Float, Float) -> Float;
foreign "MIDORI_FFI_Hypot" Hypot: fn(Float, Float) -> Float;
foreign "MIDORI_FFI_Random" Random: fn() -> Float;
foreign "MIDORI_FFI_RandomInt" RandomIntRaw: fn(Int, Int) -> Int;
foreign "MIDORI_FFI_RandomFloat" RandomFloat: fn(Float, Float) -> Float;
def RandomInt = fn(minimum: Int, maximum: Int) -> Int => {
    if minimum > maximum then RandomInt(maximum, minimum) else if minimum == maximum then minimum else Floor(RandomFloat(minimum as Float, (maximum + 1) as Float)) as Int
};
foreign "MIDORI_FFI_ToRadians" ToRadians: fn(Float) -> Float;
foreign "MIDORI_FFI_ToDegrees" ToDegrees: fn(Float) -> Float;
foreign "MIDORI_FFI_IsNaN" IsNaN: fn(Float) -> Bool;
foreign "MIDORI_FFI_IsInf" IsInf: fn(Float) -> Bool;
foreign "MIDORI_FFI_IsFinite" IsFinite: fn(Float) -> Bool;
