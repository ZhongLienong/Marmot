module Concurrency
import { "./Prelude/Result.mmt", "./Prelude/Panic.mmt", "./ArrayUtil.mmt", "./Transferable.mmt" }
use Result.{
    Result
}
public export { Spawn, Join, MakeChannel, Close, IsDone, Cancel, WorkerError, JoinedOrPanic, ParallelMap }
// Spawn, Join, Close, IsDone and Cancel are each one instruction of the VM, declared
// as a `foreign` with no library whose symbol names the instruction: a primitive. A
// primitive is called like a function, but it is not a value.
//
// Spawn(argument, F) runs F in a new worker. The one argument stands for all of F's
// parameters: the value itself for one, a tuple spread across them for several, and
// `()` for none, so a value can be piped in: `(ch, 5) |> Concurrency::Spawn(Producer)`.
// The type written here is the one-parameter case, and the compiler checks the others.
foreign "MIDORI_PRIMITIVE_Spawn" Spawn: fn(A, fn(A) -> R) -> Worker < R >;
// Join(w) waits for the worker. A cancelled or failed worker is an ordinary value the
// joining code can inspect and recover from, rather than an error that stops it. The
// VM builds the result by position, so the compiler checks that Result's first member
// holds the value and its second a WorkerError, and that WorkerError's first member
// holds nothing and its second the worker's error message.
foreign "MIDORI_PRIMITIVE_Join" Join: fn(Worker < T >) -> Result < T, WorkerError >;
// MakeChannel(capacity) takes its element type from where it is bound:
// `def ch : Channel<Int> = Concurrency::MakeChannel(4);`. Only a transferable value
// can go through a channel, so only such a channel can be made.
foreign "MIDORI_PRIMITIVE_ChannelNew" ChannelNew: fn(Int) -> Channel < T >;
def MakeChannel = fn < T >(capacity: Int) -> Channel < T > where Transferable < T > => ChannelNew(capacity);
foreign "MIDORI_PRIMITIVE_ChannelClose" Close: fn(Channel < T >) -> Unit;
foreign "MIDORI_PRIMITIVE_WorkerIsDone" IsDone: fn(Worker < T >) -> Bool;
foreign "MIDORI_PRIMITIVE_WorkerCancel" Cancel: fn(Worker < T >) -> Bool;
// What Join reports when a worker does not produce its value.
type WorkerError = Cancelled | Failed(Text);
// For code that treats a worker failure as fatal, which is what joining itself did
// before it returned a Result.
def JoinedOrPanic = fn < T >(result: Result < T, WorkerError >) -> T => {
    match result with
        case Result::Ok(value) => value
        case Result::Err(error) => {
        match error with
            case WorkerError::Cancelled() => Panic::Panic("Worker cancelled.")
            case WorkerError::Failed(message) => Panic::Panic(message)
    }
};
// Joins the chunk workers in order, so the result is the input's order regardless of
// which worker finishes first.
def ConcatChunks = fn < T >(chunks: Array < Array < T >>, index: Int, gathered: Array < T >) -> Array < T > =>
    if index >= ArrayUtil::Length(chunks)
    then gathered
    else ConcatChunks(chunks, index + 1, ArrayUtil::Concat(gathered, chunks[index]));
// Maps `work` over `values` in parallel, one worker per chunk of `chunk_size`. This is
// ordinary Marmot: the per-chunk worker is a lambda that captures `work` and crosses to
// the worker with it, which is what makes a parallel map expressible in the language
// rather than something the compiler has to provide.
def ParallelMap = fn < A, B >(values: Array < A >, work: fn(A) -> B, chunk_size: Int) -> Array < B > where Transferable < A >, Transferable < B > => {
    def count = ArrayUtil::Length(values);
    def size = if chunk_size < 1 then 1 else chunk_size;
    def chunk_count = (count + size - 1) / size;
    def workers = [Spawn(ArrayUtil::Slice(values, index * size, (index + 1) * size), fn(chunk: Array < A >) -> Array < B > => [work(item) for item in chunk]) for index in 0..1..chunk_count];
    def chunks = [JoinedOrPanic(Join(worker)) for worker in workers];
    ConcatChunks(chunks, 0, [])
};
