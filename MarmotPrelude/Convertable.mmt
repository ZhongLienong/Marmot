module Convertable
public export { Convertable }
class Convertable < From, To > {
    Convert: fn(value: From) -> To;
};
instance Convertable < Int, Float > {
    def Convert = fn(value: Int) -> Float => value as Float;
};
instance Convertable < Int, Text > {
    def Convert = fn(value: Int) -> Text => value as Text;
};
instance Convertable < Int, Bool > {
    def Convert = fn(value: Int) -> Bool => if value == 0 then false else true;
};
instance Convertable < Int, Int > {
    def Convert = fn(value: Int) -> Int => value;
};
instance Convertable < Float, Int > {
    def Convert = fn(value: Float) -> Int => value as Int;
};
instance Convertable < Float, Text > {
    def Convert = fn(value: Float) -> Text => value as Text;
};
instance Convertable < Float, Bool > {
    def Convert = fn(value: Float) -> Bool => if value == 0.0 then false else true;
};
instance Convertable < Float, Float > {
    def Convert = fn(value: Float) -> Float => value;
};
instance Convertable < Text, Int > {
    def Convert = fn(value: Text) -> Int => value as Int;
};
instance Convertable < Text, Float > {
    def Convert = fn(value: Text) -> Float => value as Float;
};
instance Convertable < Text, Text > {
    def Convert = fn(value: Text) -> Text => value;
};
instance Convertable < Bool, Int > {
    def Convert = fn(value: Bool) -> Int => if value then 1 else 0;
};
instance Convertable < Bool, Float > {
    def Convert = fn(value: Bool) -> Float => if value then 1.0 else 0.0;
};
instance Convertable < Bool, Text > {
    def Convert = fn(value: Bool) -> Text => if value then "true" else "false";
};
instance Convertable < Bool, Bool > {
    def Convert = fn(value: Bool) -> Bool => value;
};
def ShownElementsFrom = fn < T >(values: Array < T >, index: Int, shown: Text) -> Text where Convertable < T, Text > =>
    if index >= #values then shown else ShownElementsFrom(values, index + 1, (if index == 0 then shown else shown ++ ", ") ++ (values[index] as Text));
// `[a, b]`, each element as its own `as Text` gives it.
instance Convertable < Array < T >, Text > where Convertable < T, Text > {
    def Convert = fn(value: Array < T >) -> Text => "[" ++ ShownElementsFrom(value, 0, "") ++ "]";
};
