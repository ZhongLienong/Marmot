module ArrayUtil
import { "./Equatable.mmt" }
public export { Length, Contains, Slice, Reverse, Copy, Concat, WithAppended, WithReplaced, WithInserted, WithRemoved }
def Length = fn < T >(array: Array < T >) -> Int =>#array;
def ContainsFrom = fn < T >(array: Array < T >, value: T, index: Int) -> Bool where Equatable < T > =>
    if index >= Length(array)
    then false
    else if Equatable::Equals(array[index], value) then true else ContainsFrom(array, value, index + 1);
def Contains = fn < T >(array: Array < T >, value: T) -> Bool where Equatable < T > => ContainsFrom(array, value, 0);
// The copies are the runtime's: element by element in Marmot, WithAppended
// in a loop was about thirty times slower, on top of being quadratic.
foreign "MIDORI_FFI_ArraySlice" ArraySlice: fn(Array < T >, Int, Int) -> Array < T >;
foreign "MIDORI_FFI_ArrayReverse" ArrayReverse: fn(Array < T >) -> Array < T >;
def Copy = fn < T >(array: Array < T >) -> Array < T > => ArraySlice(array, 0, Length(array));
def Concat = fn < T >(first: Array < T >, second: Array < T >) -> Array < T > => first ++ second;
def WithAppended = fn < T >(array: Array < T >, value: T) -> Array < T > => array ++ [value];
def WithReplaced = fn < T >(array: Array < T >, index: Int, value: T) -> Array < T > =>
    if (index < 0) || (index >= Length(array)) then Copy(array) else ArraySlice(array, 0, index) ++ [value] ++ ArraySlice(array, index + 1, Length(array));
def WithInserted = fn < T >(array: Array < T >, index: Int, value: T) -> Array < T > => ArraySlice(array, 0, index) ++ [value] ++ ArraySlice(array, index, Length(array));
def WithRemoved = fn < T >(array: Array < T >, index: Int) -> Array < T > =>
    if (index < 0) || (index >= Length(array)) then Copy(array) else ArraySlice(array, 0, index) ++ ArraySlice(array, index + 1, Length(array));
def Slice = fn < T >(array: Array < T >, start: Int, end: Int) -> Array < T > => ArraySlice(array, start, end);
def Reverse = fn < T >(array: Array < T >) -> Array < T > => ArrayReverse(array);
