MIDORI_IR_BINARY(SubWord, Word, Word, Pure, None)
MIDORI_IR_BINARY(MulWord, Word, Word, Pure, None)
MIDORI_IR_BINARY(DivWord, Word, Word, Fault, DivisionByZero)
MIDORI_IR_BINARY(ModWord, Word, Word, Fault, DivisionByZero)

MIDORI_IR_BINARY(BitAndInt, Int, Int, Pure, None)
MIDORI_IR_BINARY(BitOrInt, Int, Int, Pure, None)
