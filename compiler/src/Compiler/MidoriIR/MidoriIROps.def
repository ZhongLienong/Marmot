// Every MidoriIR instruction. Include this after defining the macros you need;
// any left undefined expands to nothing.
//
// MIDORI_IR_UNARY(name, operand, result, effect, fault)
// MIDORI_IR_BINARY(name, operand, result, effect, fault)
//     A fixed signature over scalar types, checked by the verifier from here.
// MIDORI_IR_SPECIAL(name, effect, fault)
//     A signature that depends on the operands' types, checked by hand.
// MIDORI_IR_TERMINATOR(name)
//     Ends a block. Defines no value.
//
// `effect` and `fault` are what the builder gives the instruction; a pass may
// weaken them once it proves more, as DCE does for a non-zero constant divisor.

#ifndef MIDORI_IR_UNARY
#define MIDORI_IR_UNARY(name, operand, result, effect, fault)
#endif
#ifndef MIDORI_IR_BINARY
#define MIDORI_IR_BINARY(name, operand, result, effect, fault)
#endif
#ifndef MIDORI_IR_SPECIAL
#define MIDORI_IR_SPECIAL(name, effect, fault)
#endif
#ifndef MIDORI_IR_TERMINATOR
#define MIDORI_IR_TERMINATOR(name)
#endif

MIDORI_IR_SPECIAL(Const, Pure, None)

MIDORI_IR_BINARY(AddInt, Int, Int, Pure, None)
MIDORI_IR_BINARY(SubInt, Int, Int, Pure, None)
MIDORI_IR_BINARY(MulInt, Int, Int, Pure, None)
MIDORI_IR_BINARY(DivInt, Int, Int, Fault, DivisionByZero)
MIDORI_IR_BINARY(ModInt, Int, Int, Fault, DivisionByZero)
