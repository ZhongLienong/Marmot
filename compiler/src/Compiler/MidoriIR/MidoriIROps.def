MIDORI_IR_BINARY(SubByte, Byte, Byte, Pure, None)
MIDORI_IR_BINARY(MulByte, Byte, Byte, Pure, None)
MIDORI_IR_BINARY(DivByte, Byte, Byte, Fault, DivisionByZero)
MIDORI_IR_BINARY(ModByte, Byte, Byte, Fault, DivisionByZero)
